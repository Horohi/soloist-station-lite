#!/bin/sh
# Soloist Management CLI for Yandex Station
# https://github.com/Horohi/soloist-station-lite

set -e

# Sanitize PATH
export PATH="/data/opt/bin:/opt/bin:/bin:/usr/bin:/sbin:/usr/sbin:$PATH"
unset LD_LIBRARY_PATH LD_PRELOAD

INSTALL_DIR="${INSTALL_DIR:-/data/opt/soloist}"
[ -d "$INSTALL_DIR" ] || INSTALL_DIR="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)"

CURL_BIN="$INSTALL_DIR/bin/curl"
[ -x "$CURL_BIN" ] || CURL_BIN="curl"

GITHUB_REPO="Horohi/soloist-station-lite"

# Colors (if terminal supports it)
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    NC='\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' CYAN='' BOLD='' NC=''
fi

cmd_help() {
    printf "${BOLD}${GREEN}Spotify Soloist CLI для Яндекс Станции${NC}\n"
    printf "Использование: ${CYAN}soloist <команда>${NC}\n\n"
    printf "${BOLD}Команды управления:${NC}\n"
    printf "  ${CYAN}status${NC}       Статус плеера, моста, памяти, подсветки и текущего трека\n"
    printf "  ${CYAN}led${NC} [on|off|white|rainbow|cyan|status]  Управление эквалайзером подсветки\n"
    printf "  ${CYAN}restart${NC}      Перезапустить службу Spotify и мост управления\n"
    printf "  ${CYAN}start${NC}        Запустить службу\n"
    printf "  ${CYAN}stop${NC}         Остановить службу\n"
    printf "  ${CYAN}logs${NC} [bridge] Показать логи в реальном времени (по умолч. soloist, 'bridge' — мост)\n\n"
    printf "${BOLD}Обслуживание и диск:${NC}\n"
    printf "  ${CYAN}update${NC} [--force]  Обновить Soloist до свежего релиза с GitHub в 1 команду\n"
    printf "  ${CYAN}clean${NC}        Очистить кэш, старые логи и мусор в /data/local/tmp\n"
    printf "  ${CYAN}version${NC}      Показать текущую версию и доступную на GitHub\n"
    printf "\n"
}

get_current_version() {
    if [ -f "$INSTALL_DIR/version" ]; then
        cat "$INSTALL_DIR/version"
    elif [ -f "$INSTALL_DIR/README.md" ]; then
        grep -o 'v1\.[0-9]\+\.[0-9]\+' "$INSTALL_DIR/README.md" 2>/dev/null | head -n 1 || echo "v1.x"
    else
        echo "v1.x"
    fi
}

cmd_version() {
    CURR=$(get_current_version)
    printf "Установленная версия: ${BOLD}${GREEN}%s${NC}\n" "$CURR"
    printf "Проверка обновлений на GitHub... "
    LATEST=$("$CURL_BIN" -s "https://api.github.com/repos/$GITHUB_REPO/releases/latest" 2>/dev/null | grep '"tag_name":' | head -n 1 | cut -d'"' -f4 || true)
    if [ -n "$LATEST" ]; then
        printf "Последняя версия: ${BOLD}${CYAN}%s${NC}\n" "$LATEST"
        if [ "$CURR" = "$LATEST" ]; then
            printf "${GREEN}У вас установлена самая актуальная версия!${NC}\n"
        else
            printf "${YELLOW}Доступно обновление! Запустите: soloist update${NC}\n"
        fi
    else
        printf "${RED}Не удалось подключиться к GitHub API${NC}\n"
    fi
}

cmd_status() {
    printf "${BOLD}=== Spotify Soloist Status ===${NC}\n"

    # Soloist daemon
    SOLO_PID=$(pidof soloist 2>/dev/null | awk '{print $NF}' || cat "$INSTALL_DIR/data/soloist.pid" 2>/dev/null || true)
    if [ -n "$SOLO_PID" ] && kill -0 "$SOLO_PID" 2>/dev/null; then
        RSS_KB=$(awk '/VmRSS/{print $2}' "/proc/$SOLO_PID/status" 2>/dev/null || echo "0")
        RSS_MB=$((RSS_KB / 1024))
        printf "  Soloist Daemon: ${GREEN}RUNNING${NC} (PID: %s, RAM: %s MB)\n" "$SOLO_PID" "$RSS_MB"
    else
        printf "  Soloist Daemon: ${RED}STOPPED${NC}\n"
    fi

    # Bridge daemon
    BRIDGE_PID=$(pidof soloist-bridge 2>/dev/null || cat "$INSTALL_DIR/data/bridge.pid" 2>/dev/null || true)
    if [ -n "$BRIDGE_PID" ] && kill -0 "$BRIDGE_PID" 2>/dev/null; then
        BR_RSS=$(awk '/VmRSS/{print $2}' "/proc/$BRIDGE_PID/status" 2>/dev/null || echo "0")
        printf "  Soloist Bridge: ${GREEN}RUNNING${NC} (PID: %s, RAM: %s KB)\n" "$BRIDGE_PID" "$BR_RSS"
    else
        printf "  Soloist Bridge: ${RED}STOPPED${NC}\n"
    fi

    # LED visualizer state
    if [ -f "$INSTALL_DIR/data/requests/led_state" ]; then
        LED_ST=$(cat "$INSTALL_DIR/data/requests/led_state" 2>/dev/null || echo "off")
        if [ "$LED_ST" = "on" ]; then
            printf "  Светомузыка:    ${GREEN}ВКЛЮЧЕНА (Nothing Phone / Equalizer)${NC}\n"
        else
            printf "  Светомузыка:    ${YELLOW}ВЫКЛЮЧЕНА${NC}\n"
        fi
    fi

    # Soloist API status
    if [ -x "$INSTALL_DIR/bin/soloist" ]; then
        STATUS_OUT=$(LD_LIBRARY_PATH="$INSTALL_DIR/lib64" "$INSTALL_DIR/bin/soloist" ctl -w 127.0.0.1:9090 status 2>/dev/null || true)
        if [ -n "$STATUS_OUT" ]; then
            printf "\n${BOLD}Spotify API & Сессия:${NC}\n"
            printf "%s\n" "$STATUS_OUT" | sed 's/^/  /'
        fi
    fi

    # Current Track
    if [ -f "$INSTALL_DIR/data/requests/track" ]; then
        TRACK_URI=$(head -n 1 "$INSTALL_DIR/data/requests/track" 2>/dev/null || true)
        if [ -n "$TRACK_URI" ]; then
            printf "  Текущий трек:   ${CYAN}%s${NC}\n" "$TRACK_URI"
        fi
    fi

    # Memory
    printf "\n${BOLD}Память и диск:${NC}\n"
    free -m 2>/dev/null | awk 'NR<=2{printf "  %s\n", $0}' || true
    df -h /data 2>/dev/null | awk 'NR<=2{printf "  %s\n", $0}' || true
}

cmd_led() {
    ACTION="${1:-status}"
    REQ_FILE="$INSTALL_DIR/data/requests/led"
    STATE_FILE="$INSTALL_DIR/data/requests/led_state"
    mkdir -p "$INSTALL_DIR/data/requests"

    case "$ACTION" in
        on|1)
            printf "1\n" > "$REQ_FILE"
            printf "${GREEN}Эквалайзер / Светомузыка включена! (Nothing Phone style)${NC}\n"
            ;;
        off|0)
            printf "0\n" > "$REQ_FILE"
            printf "${YELLOW}Эквалайзер / Светомузыка выключена.${NC}\n"
            ;;
        white|w)
            printf "w\n" > "$REQ_FILE"
            printf "${BOLD}Цвет эквалайзера: Белый (Nothing Phone style)${NC}\n"
            ;;
        rainbow|r)
            printf "r\n" > "$REQ_FILE"
            printf "${BOLD}${CYAN}Цвет эквалайзера: Радуга (Rainbow)${NC}\n"
            ;;
        cyan|c)
            printf "c\n" > "$REQ_FILE"
            printf "${BOLD}${CYAN}Цвет эквалайзера: Бирюзовый (Cyan)${NC}\n"
            ;;
        status|state)
            if [ -f "$STATE_FILE" ]; then
                ST=$(cat "$STATE_FILE" 2>/dev/null || echo "off")
                if [ "$ST" = "on" ]; then
                    printf "Статус светомузыки: ${BOLD}${GREEN}ВКЛЮЧЕНА (Nothing Phone / Equalizer)${NC}\n"
                else
                    printf "Статус светомузыки: ${BOLD}${YELLOW}ВЫКЛЮЧЕНА${NC}\n"
                fi
            else
                printf "Статус светомузыки: ${YELLOW}ВЫКЛЮЧЕНА (по умолчанию)${NC}\n"
            fi
            ;;
        *)
            printf "Использование: soloist led [on|off|white|rainbow|cyan|status]\n"
            ;;
    esac
}

cmd_restart() {
    printf "Перезапуск Spotify Soloist...\n"
    "$INSTALL_DIR/stop.sh" >/dev/null 2>&1 || true
    sleep 1
    sh "$INSTALL_DIR/start.sh"
    printf "${GREEN}Готово! Служба перезапущена.${NC}\n"
}

cmd_start() {
    printf "Запуск Spotify Soloist...\n"
    sh "$INSTALL_DIR/start.sh"
    printf "${GREEN}Запущено.${NC}\n"
}

cmd_stop() {
    printf "Остановка Spotify Soloist...\n"
    "$INSTALL_DIR/stop.sh"
    printf "${YELLOW}Остановлено.${NC}\n"
}

cmd_logs() {
    LOG_FILE="/tmp/soloist.log"
    if [ "${1:-}" = "bridge" ] || [ "${1:-}" = "b" ]; then
        LOG_FILE="/tmp/soloist-bridge.log"
    elif [ "${1:-}" = "search" ] || [ "${1:-}" = "s" ]; then
        LOG_FILE="/tmp/soloist-search.log"
    fi

    if [ ! -f "$LOG_FILE" ]; then
        printf "${RED}Файл логов %s пока не создан.${NC}\n" "$LOG_FILE"
        exit 0
    fi

    printf "${CYAN}=== Просмотр логов: %s (Ctrl+C для выхода) ===${NC}\n" "$LOG_FILE"
    tail -n 40 -f "$LOG_FILE"
}

cmd_clean() {
    printf "${BOLD}Очистка временных файлов и мусора...${NC}\n"
    SPACE_BEFORE=$(df /data | awk 'NR==2 {print $4}')

    # 1. Clean installer leftover in /data/local/tmp
    rm -rf /data/local/tmp/soloist* /data/local/tmp/*.tar.gz 2>/dev/null || true

    # 2. Clean bloated logs in /tmp
    for l in /tmp/soloist.log /tmp/soloist-bridge.log /tmp/soloist-search.log; do
        if [ -f "$l" ]; then
            tail -n 100 "$l" > "$l.tmp" 2>/dev/null && mv "$l.tmp" "$l" 2>/dev/null || true
        fi
    done

    # 3. Clean old audio stream chunks from cache
    if [ -d /tmp/soloist_cache/cache ]; then
        find /tmp/soloist_cache/cache -type f -amin +15 -delete 2>/dev/null || true
    fi

    # 4. Clean update leftovers in /bkupgrade
    rm -f /bkupgrade/update_* /bkupgrade/ota/* /bkupgrade/uImage* 2>/dev/null || true

    # 5. Clean bak files
    rm -f "$INSTALL_DIR"/*.bak "$INSTALL_DIR"/*.tmp 2>/dev/null || true

    # 6. Ensure Storage cache lives in RAM tmpfs to protect flash memory
    mkdir -p /tmp/soloist_cache/Storage
    if [ ! -L "$INSTALL_DIR/data/cache/Storage" ]; then
        rm -rf "$INSTALL_DIR/data/cache/Storage" 2>/dev/null || true
        ln -sfn /tmp/soloist_cache/Storage "$INSTALL_DIR/data/cache/Storage" 2>/dev/null || true
    fi

    # 7. Drop inactive kernel page cache to free RAM
    sync && echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true

    SPACE_AFTER=$(df /data | awk 'NR==2 {print $4}')
    DIFF=$((SPACE_AFTER - SPACE_BEFORE))
    if [ "$DIFF" -gt 0 ]; then
        printf "${GREEN}Успешно! Освобождено в /data: %s КБ (~%s МБ)${NC}\n" "$DIFF" "$((DIFF / 1024))"
    else
        printf "${GREEN}Мусора не обнаружено, система чистая.${NC}\n"
    fi
    printf "Свободно в /data: ${BOLD}%s КБ${NC}\n" "$SPACE_AFTER"
}

cmd_update() {
    FORCE="${1:-}"
    CURR=$(get_current_version)
    printf "${BOLD}Проверка обновлений с GitHub (${GITHUB_REPO})...${NC}\n"

    LATEST_JSON=$("$CURL_BIN" -s "https://api.github.com/repos/$GITHUB_REPO/releases/latest" 2>/dev/null || true)
    LATEST=$(printf '%s\n' "$LATEST_JSON" | grep '"tag_name":' | head -n 1 | cut -d'"' -f4 || true)

    if [ -z "$LATEST" ]; then
        printf "${RED}Ошибка: Не удалось получить информацию о последнем релизе с GitHub.${NC}\n"
        exit 1
    fi

    printf "Текущая версия: ${BOLD}%s${NC}, последняя доступная: ${BOLD}${CYAN}%s${NC}\n" "$CURR" "$LATEST"

    if [ "$CURR" = "$LATEST" ] && [ "$FORCE" != "--force" ]; then
        printf "${GREEN}У вас уже установлена самая последняя версия!${NC}\n"
        printf "Для принудительной переустановки выполните: ${CYAN}soloist update --force${NC}\n"
        exit 0
    fi

    DOWNLOAD_URL="https://github.com/$GITHUB_REPO/releases/download/$LATEST/soloist-station-lite.tar.gz"
    TMP_DIR="/tmp/soloist_update_$$"
    ARCHIVE="/tmp/soloist_update_$$.tar.gz"

    mkdir -p "$TMP_DIR"
    trap 'rm -rf "$TMP_DIR" "$ARCHIVE" 2>/dev/null || true' EXIT HUP INT TERM

    printf "Загрузка релиза %s...\n" "$LATEST"
    if ! "$CURL_BIN" -L -f -o "$ARCHIVE" "$DOWNLOAD_URL"; then
        printf "${RED}Ошибка загрузки архива с GitHub!${NC}\n"
        exit 1
    fi

    printf "Распаковка обновления...\n"
    tar -xzf "$ARCHIVE" -C "$TMP_DIR"

    # Stop current services
    printf "Остановка старых служб...\n"
    "$INSTALL_DIR/stop.sh" >/dev/null 2>&1 || true

    # Backup existing configuration
    SAVED_CONF=""
    if [ -f "$INSTALL_DIR/spotify_api.conf" ]; then
        cp -f "$INSTALL_DIR/spotify_api.conf" "$TMP_DIR/spotify_api.conf.saved"
    fi
    SAVED_KEY=""
    if [ -f "$INSTALL_DIR/start.sh" ]; then
        SAVED_KEY=$(grep -o 'API_KEY="[^"]*"' "$INSTALL_DIR/start.sh" 2>/dev/null | cut -d'"' -f2 || true)
    fi

    # Update files
    printf "Установка обновлений в %s...\n" "$INSTALL_DIR"
    mkdir -p "$INSTALL_DIR/bin" "$INSTALL_DIR/scripts" "$INSTALL_DIR/lib64" "$INSTALL_DIR/data"

    # Copy new binaries & scripts
    if [ -f "$TMP_DIR/bin/soloist-bridge" ]; then
        cp -f "$TMP_DIR/bin/soloist-bridge" "$INSTALL_DIR/bin/soloist-bridge"
        chmod 755 "$INSTALL_DIR/bin/soloist-bridge"
    fi
    if [ -f "$TMP_DIR/bin/curl" ]; then
        cp -f "$TMP_DIR/bin/curl" "$INSTALL_DIR/bin/curl"
        chmod 755 "$INSTALL_DIR/bin/curl"
    fi
    if [ -f "$TMP_DIR/bin/soloist" ]; then
        cp -f "$TMP_DIR/bin/soloist" "$INSTALL_DIR/bin/soloist"
        chmod 755 "$INSTALL_DIR/bin/soloist"
    fi
    if [ -d "$TMP_DIR/lib64" ]; then
        cp -af "$TMP_DIR/lib64/"* "$INSTALL_DIR/lib64/"
    fi
    if [ -d "$TMP_DIR/scripts" ]; then
        cp -rf "$TMP_DIR/scripts/"* "$INSTALL_DIR/scripts/"
        chmod 755 "$INSTALL_DIR/scripts/"*.sh 2>/dev/null || true
    fi

    # Update CLI itself
    if [ -f "$TMP_DIR/scripts/soloist-cli" ]; then
        cp -f "$TMP_DIR/scripts/soloist-cli" "$INSTALL_DIR/bin/soloist-cli"
        chmod 755 "$INSTALL_DIR/bin/soloist-cli"
        ln -sf "$INSTALL_DIR/bin/soloist-cli" /data/opt/bin/soloist 2>/dev/null || true
        ln -sf "$INSTALL_DIR/bin/soloist-cli" /data/opt/bin/soloistctl 2>/dev/null || true
    fi

    # Save version
    printf "%s\n" "$LATEST" > "$INSTALL_DIR/version"

    # Restore conf if needed
    if [ -f "$TMP_DIR/spotify_api.conf.saved" ]; then
        cp -f "$TMP_DIR/spotify_api.conf.saved" "$INSTALL_DIR/spotify_api.conf"
    fi

    # Restart
    printf "Запуск обновлённого Soloist...\n"
    sh "$INSTALL_DIR/start.sh"

    # Cleanup temporary update files
    rm -rf "$TMP_DIR" "$ARCHIVE" /data/local/tmp/soloist* 2>/dev/null || true

    printf "\n${BOLD}${GREEN}Обновление до %s успешно завершено!${NC}\n" "$LATEST"
    printf "Временный мусор и архив автоматически удалены.\n"
}

# Main entrypoint
case "${1:-}" in
    status|st)
        cmd_status
        ;;
    led)
        shift
        cmd_led "$@"
        ;;
    restart|res)
        cmd_restart
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    logs|log)
        shift
        cmd_logs "$@"
        ;;
    clean|gc)
        cmd_clean
        ;;
    update|up)
        shift
        cmd_update "$@"
        ;;
    version|-v|--version)
        cmd_version
        ;;
    help|-h|--help|"")
        cmd_help
        ;;
    *)
        printf "${RED}Неизвестная команда: %s${NC}\n\n" "$1"
        cmd_help
        exit 1
        ;;
esac
