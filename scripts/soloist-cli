#!/bin/sh
# Soloist Management CLI for Yandex Station
# https://github.com/Horohi/soloist-station-lite

set -e

# Sanitize PATH
export PATH="/data/opt/bin:/opt/bin:/bin:/usr/bin:/sbin:/usr/sbin:$PATH"
unset LD_LIBRARY_PATH LD_PRELOAD

IS_YAM=0
if [ -n "${INSTALL_DIR:-}" ]; then
    case "$INSTALL_DIR" in */share/horohi.soloist) IS_YAM=1 ;; esac
elif [ -n "${YAM_PKG:-}" ] && [ -d "$YAM_PKG/share/horohi.soloist/bin" ]; then
    INSTALL_DIR="$YAM_PKG/share/horohi.soloist"
    IS_YAM=1
else
    _cli_parent="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)"
    _cli_real="$(readlink -f "$0" 2>/dev/null || true)"
    _cli_real_parent=""
    [ -z "$_cli_real" ] || _cli_real_parent="$(cd "$(dirname "$_cli_real")/.." 2>/dev/null && pwd)"

    if [ -d "$_cli_parent/share/horohi.soloist/bin" ]; then
        INSTALL_DIR="$_cli_parent/share/horohi.soloist"
        YAM_ROOT="$_cli_parent"
        IS_YAM=1
    elif [ -n "$_cli_real_parent" ] && [ -d "$_cli_real_parent/share/horohi.soloist/bin" ]; then
        INSTALL_DIR="$_cli_real_parent/share/horohi.soloist"
        IS_YAM=1
    elif [ -d "$_cli_parent/bin" ] && [ -f "$_cli_parent/scripts/control.sh" ]; then
        INSTALL_DIR="$_cli_parent"
        case "$INSTALL_DIR" in */share/horohi.soloist) IS_YAM=1 ;; esac
    elif [ -d "${YAM_ROOT:-/data/yam}/share/horohi.soloist/bin" ]; then
        INSTALL_DIR="${YAM_ROOT:-/data/yam}/share/horohi.soloist"
        IS_YAM=1
    else
        INSTALL_DIR="/data/opt/soloist"
    fi
fi

if [ "$IS_YAM" = 1 ]; then
    if [ -z "${YAM_ROOT:-}" ]; then
        case "$INSTALL_DIR" in
            */pkgs/horohi/soloist/*/share/horohi.soloist) YAM_ROOT="${INSTALL_DIR%/pkgs/horohi/soloist/*/share/horohi.soloist}" ;;
            */share/horohi.soloist) YAM_ROOT="${INSTALL_DIR%/share/horohi.soloist}" ;;
            *) YAM_ROOT="/data/yam" ;;
        esac
    fi
    _var_base="${YAM_VAR:-$YAM_ROOT/var}"
    _etc_base="${YAM_ETC:-$YAM_ROOT/etc}"
    if [ "$YAM_ROOT" != "/data/yam" ]; then
        [ "$_var_base" != "/data/yam/var" ] || _var_base="$YAM_ROOT/var"
        [ "$_etc_base" != "/data/yam/etc" ] || _etc_base="$YAM_ROOT/etc"
    fi
    DATA_ROOT="$_var_base/horohi.soloist"
    CONF_DIR="$_etc_base/horohi.soloist"
    CACHE_DIR="${SOLOIST_CACHE_DIR:-${YAM_RUN:-/tmp}/soloist_cache}"
else
    DATA_ROOT="$INSTALL_DIR/data"
    CONF_DIR="$INSTALL_DIR"
    CACHE_DIR="${SOLOIST_CACHE_DIR:-/tmp/soloist_cache}"
fi

CURL_BIN="$INSTALL_DIR/bin/curl"
[ -x "$CURL_BIN" ] || CURL_BIN="curl"

GITHUB_REPO="Horohi/soloist-station-lite"

# Colors (if terminal supports it)
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    NC='\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' CYAN='' BOLD='' NC=''
fi

cmd_help() {
    printf "${BOLD}${GREEN}Spotify Soloist CLI для Яндекс Станции${NC}\n"
    printf "Использование: ${CYAN}soloist <команда>${NC}\n\n"
    printf "${BOLD}Команды управления:${NC}\n"
    printf "  ${CYAN}setup${NC}        Интерактивный мастер настройки ключей API, имени колонки и SNI-прокси\n"
    printf "  ${CYAN}status${NC}       Статус плеера, моста, памяти, подсветки и текущего трека\n"
    printf "  ${CYAN}led${NC} [on|off|white|rainbow|cyan|status]  Управление эквалайзером подсветки\n"
    printf "  ${CYAN}restart${NC}      Перезапустить службу Spotify и мост управления\n"
    printf "  ${CYAN}start${NC}        Запустить службу\n"
    printf "  ${CYAN}stop${NC}         Остановить службу\n"
    printf "  ${CYAN}logs${NC} [bridge] Показать логи в реальном времени (по умолч. soloist, 'bridge' — мост)\n\n"
    printf "${BOLD}Обслуживание и диск:${NC}\n"
    printf "  ${CYAN}update${NC} [--force]  Обновить Soloist до свежего релиза с GitHub в 1 команду\n"
    printf "  ${CYAN}clean${NC}        Очистить кэш, старые логи и мусор в /data/local/tmp\n"
    printf "  ${CYAN}version${NC}      Показать текущую версию и доступную на GitHub\n"
    printf "\n"
}

get_current_version() {
    if [ -f "$INSTALL_DIR/version" ]; then
        cat "$INSTALL_DIR/version"
    elif [ -f "$INSTALL_DIR/README.md" ]; then
        grep -o 'v1\.[0-9]\+\.[0-9]\+' "$INSTALL_DIR/README.md" 2>/dev/null | head -n 1 || echo "v1.x"
    else
        echo "v1.x"
    fi
}

cmd_version() {
    CURR=$(get_current_version)
    printf "Установленная версия: ${BOLD}${GREEN}%s${NC}\n" "$CURR"
    printf "Проверка обновлений на GitHub... "
    LATEST=$("$CURL_BIN" -s "https://api.github.com/repos/$GITHUB_REPO/releases/latest" 2>/dev/null | grep '"tag_name":' | head -n 1 | cut -d'"' -f4 || true)
    if [ -n "$LATEST" ]; then
        printf "Последняя версия: ${BOLD}${CYAN}%s${NC}\n" "$LATEST"
        if [ "$CURR" = "$LATEST" ]; then
            printf "${GREEN}У вас установлена самая актуальная версия!${NC}\n"
        else
            printf "${YELLOW}Доступно обновление! Запустите: soloist update${NC}\n"
        fi
    else
        printf "${RED}Не удалось подключиться к GitHub API${NC}\n"
    fi
}

find_live_pid() {
    _proc="$1"
    for _p in $(pidof "$_proc" 2>/dev/null || true) $(cat "$DATA_ROOT/${_proc}.pid" 2>/dev/null || true) $(cat "$CACHE_DIR/${_proc}.pid" 2>/dev/null || true); do
        [ -n "$_p" ] && [ "$_p" != "$$" ] && [ "$_p" != "${PPID:-0}" ] && kill -0 "$_p" 2>/dev/null || continue
        _exe=$(readlink "/proc/$_p/exe" 2>/dev/null || true)
        case "$_exe" in
            */busybox|*/sh|*/ash|*/dash|*/bash) continue ;;
        esac
        _comm=$(cat "/proc/$_p/comm" 2>/dev/null || true)
        if [ "$_comm" = "$_proc" ]; then
            printf '%s\n' "$_p"
            return 0
        elif [ "$_proc" = "soloist" ] && [ "$_comm" = "ld-linux-aarch6" ]; then
            case "$(tr '\0' ' ' < "/proc/$_p/cmdline" 2>/dev/null || true)" in
                *soloist*) printf '%s\n' "$_p"; return 0 ;;
            esac
        fi
    done
    return 1
}

run_soloist_ctl() {
    _bin="$INSTALL_DIR/bin/soloist"
    _lib="$INSTALL_DIR/lib64"
    _ld="$_lib/ld-linux-aarch64.so.1"
    if [ -x "$_ld" ] && ! LD_LIBRARY_PATH="$_lib" "$_bin" --help >/dev/null 2>&1; then
        LD_LIBRARY_PATH="$_lib" "$_ld" --library-path "$_lib" --argv0 "$_bin" "$_bin" "$@"
    else
        LD_LIBRARY_PATH="$_lib" "$_bin" "$@"
    fi
}

cmd_status() {
    printf "${BOLD}=== Spotify Soloist Status ===${NC}\n"

    # Soloist daemon
    SOLO_PID=$(find_live_pid soloist || true)
    if [ -n "$SOLO_PID" ]; then
        RSS_KB=$(awk '/VmRSS/{print $2}' "/proc/$SOLO_PID/status" 2>/dev/null || echo "0")
        RSS_MB=$((RSS_KB / 1024))
        printf "  Soloist Daemon: ${GREEN}RUNNING${NC} (PID: %s, RAM: %s MB)\n" "$SOLO_PID" "$RSS_MB"
    else
        printf "  Soloist Daemon: ${RED}STOPPED${NC}\n"
    fi

    # Bridge daemon
    BRIDGE_PID=$(find_live_pid soloist-bridge || true)
    if [ -n "$BRIDGE_PID" ]; then
        BR_RSS=$(awk '/VmRSS/{print $2}' "/proc/$BRIDGE_PID/status" 2>/dev/null || echo "0")
        printf "  Soloist Bridge: ${GREEN}RUNNING${NC} (PID: %s, RAM: %s KB)\n" "$BRIDGE_PID" "$BR_RSS"
    else
        printf "  Soloist Bridge: ${RED}STOPPED${NC}\n"
    fi

    # LED visualizer state
    if [ -f "$DATA_ROOT/requests/led_state" ]; then
        LED_ST=$(cat "$DATA_ROOT/requests/led_state" 2>/dev/null || echo "off")
        if [ "$LED_ST" = "on" ]; then
            printf "  Светомузыка:    ${GREEN}ВКЛЮЧЕНА (Nothing Phone / Equalizer)${NC}\n"
        else
            printf "  Светомузыка:    ${YELLOW}ВЫКЛЮЧЕНА${NC}\n"
        fi
    fi

    # Soloist API status
    if [ -x "$INSTALL_DIR/bin/soloist" ]; then
        STATUS_OUT=$(run_soloist_ctl ctl -w 127.0.0.1:9090 status 2>/dev/null || true)
        if [ -n "$STATUS_OUT" ]; then
            printf "\n${BOLD}Spotify API & Сессия:${NC}\n"
            printf "%s\n" "$STATUS_OUT" | sed 's/^/  /'
        fi
    fi

    # Current Track
    if [ -f "$DATA_ROOT/requests/track" ]; then
        TRACK_URI=$(head -n 1 "$DATA_ROOT/requests/track" 2>/dev/null || true)
        if [ -n "$TRACK_URI" ]; then
            printf "  Текущий трек:   ${CYAN}%s${NC}\n" "$TRACK_URI"
        fi
    fi

    if [ "$IS_YAM" = 1 ]; then
        printf "\n${BOLD}YAM v2 Пути:${NC}\n"
        printf "  Конфиг: %s\n" "$CONF_DIR"
        printf "  Данные: %s\n" "$DATA_ROOT"
    fi

    # Memory
    printf "\n${BOLD}Память и диск:${NC}\n"
    free -m 2>/dev/null | awk 'NR<=2{printf "  %s\n", $0}' || true
    df -h /data 2>/dev/null | awk 'NR<=2{printf "  %s\n", $0}' || true
}

cmd_led() {
    ACTION="${1:-status}"
    REQ_FILE="$DATA_ROOT/requests/led"
    STATE_FILE="$DATA_ROOT/requests/led_state"
    mkdir -p "$DATA_ROOT/requests"

    case "$ACTION" in
        on|1)
            printf "1\n" > "$REQ_FILE"
            printf "${GREEN}Эквалайзер / Светомузыка включена! (Nothing Phone style)${NC}\n"
            ;;
        off|0)
            printf "0\n" > "$REQ_FILE"
            printf "${YELLOW}Эквалайзер / Светомузыка выключена.${NC}\n"
            ;;
        white|w)
            printf "w\n" > "$REQ_FILE"
            printf "${BOLD}Цвет эквалайзера: Белый (Nothing Phone style)${NC}\n"
            ;;
        rainbow|r)
            printf "r\n" > "$REQ_FILE"
            printf "${BOLD}${CYAN}Цвет эквалайзера: Радуга (Rainbow)${NC}\n"
            ;;
        cyan|c)
            printf "c\n" > "$REQ_FILE"
            printf "${BOLD}${CYAN}Цвет эквалайзера: Бирюзовый (Cyan)${NC}\n"
            ;;
        status|state)
            if [ -f "$STATE_FILE" ]; then
                ST=$(cat "$STATE_FILE" 2>/dev/null || echo "off")
                if [ "$ST" = "on" ]; then
                    printf "Статус светомузыки: ${BOLD}${GREEN}ВКЛЮЧЕНА (Nothing Phone / Equalizer)${NC}\n"
                else
                    printf "Статус светомузыки: ${BOLD}${YELLOW}ВЫКЛЮЧЕНА${NC}\n"
                fi
            else
                printf "Статус светомузыки: ${YELLOW}ВЫКЛЮЧЕНА (по умолчанию)${NC}\n"
            fi
            ;;
        *)
            printf "Использование: soloist led [on|off|white|rainbow|cyan|status]\n"
            ;;
    esac
}

cmd_restart() {
    printf "Перезапуск Spotify Soloist...\n"
    if [ "$IS_YAM" = 1 ]; then
        YAM_ROOT="$YAM_ROOT" YAM_VAR="${YAM_VAR:-$YAM_ROOT/var}" YAM_ETC="${YAM_ETC:-$YAM_ROOT/etc}" \
            sh "$INSTALL_DIR/scripts/yam-init.sh" restart
    else
        "$INSTALL_DIR/stop.sh" >/dev/null 2>&1 || true
        sleep 1
        sh "$INSTALL_DIR/start.sh"
    fi
    printf "${GREEN}Готово! Служба перезапущена.${NC}\n"
}

cmd_start() {
    printf "Запуск Spotify Soloist...\n"
    if [ "$IS_YAM" = 1 ]; then
        YAM_ROOT="$YAM_ROOT" YAM_VAR="${YAM_VAR:-$YAM_ROOT/var}" YAM_ETC="${YAM_ETC:-$YAM_ROOT/etc}" \
            sh "$INSTALL_DIR/scripts/yam-init.sh" start
    else
        sh "$INSTALL_DIR/start.sh"
    fi
    printf "${GREEN}Запущено.${NC}\n"
}

cmd_stop() {
    printf "Остановка Spotify Soloist...\n"
    if [ "$IS_YAM" = 1 ]; then
        YAM_ROOT="$YAM_ROOT" YAM_VAR="${YAM_VAR:-$YAM_ROOT/var}" YAM_ETC="${YAM_ETC:-$YAM_ROOT/etc}" \
            sh "$INSTALL_DIR/scripts/yam-init.sh" stop
    else
        "$INSTALL_DIR/stop.sh"
    fi
    printf "${YELLOW}Остановлено.${NC}\n"
}

cmd_logs() {
    LOG_FILE="/tmp/soloist.log"
    if [ "${1:-}" = "bridge" ] || [ "${1:-}" = "b" ]; then
        LOG_FILE="/tmp/soloist-bridge.log"
    elif [ "${1:-}" = "search" ] || [ "${1:-}" = "s" ]; then
        LOG_FILE="/tmp/soloist-search.log"
    fi

    if [ ! -f "$LOG_FILE" ]; then
        printf "${RED}Файл логов %s пока не создан.${NC}\n" "$LOG_FILE"
        exit 0
    fi

    printf "${CYAN}=== Просмотр логов: %s (Ctrl+C для выхода) ===${NC}\n" "$LOG_FILE"
    tail -n 40 -f "$LOG_FILE"
}

cmd_clean() {
    printf "${BOLD}Очистка временных файлов и мусора...${NC}\n"
    SPACE_BEFORE=$(df /data | awk 'NR==2 {print $4}')

    # 1. Clean installer leftover in /data/local/tmp
    rm -rf /data/local/tmp/soloist* /data/local/tmp/*.tar.gz 2>/dev/null || true

    # 2. Clean bloated logs in /tmp
    for l in /tmp/soloist.log /tmp/soloist-bridge.log /tmp/soloist-search.log; do
        if [ -f "$l" ]; then
            tail -n 100 "$l" > "$l.tmp" 2>/dev/null && mv "$l.tmp" "$l" 2>/dev/null || true
        fi
    done

    # 3. Clean old audio stream chunks from cache (BusyBox find compatible)
    if [ -x "$INSTALL_DIR/scripts/control.sh" ]; then
        SOLOIST_CACHE_DIR="$CACHE_DIR/cache" sh "$INSTALL_DIR/scripts/control.sh" clean-cache 2>/dev/null || true
    elif [ -d "$CACHE_DIR/cache" ]; then
        find "$CACHE_DIR/cache" -type f -mmin +1 -exec rm -f {} + 2>/dev/null || true
    fi

    # 4. Clean update leftovers in /bkupgrade
    rm -f /bkupgrade/update_* /bkupgrade/ota/* /bkupgrade/uImage* 2>/dev/null || true

    # 5. Clean bak files
    rm -f "$INSTALL_DIR"/*.bak "$INSTALL_DIR"/*.tmp 2>/dev/null || true

    # 6. Ensure Storage cache lives in RAM tmpfs to protect flash memory
    mkdir -p "$CACHE_DIR/Storage" "$DATA_ROOT/cache"
    if [ ! -L "$DATA_ROOT/cache/Storage" ]; then
        rm -rf "$DATA_ROOT/cache/Storage" 2>/dev/null || true
        ln -sfn "$CACHE_DIR/Storage" "$DATA_ROOT/cache/Storage" 2>/dev/null || true
    fi

    # 7. Drop inactive kernel page cache to free RAM
    sync && echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true

    SPACE_AFTER=$(df /data | awk 'NR==2 {print $4}')
    DIFF=$((SPACE_AFTER - SPACE_BEFORE))
    if [ "$DIFF" -gt 0 ]; then
        printf "${GREEN}Успешно! Освобождено в /data: %s КБ (~%s МБ)${NC}\n" "$DIFF" "$((DIFF / 1024))"
    else
        printf "${GREEN}Мусора не обнаружено, система чистая.${NC}\n"
    fi
    printf "Свободно в /data: ${BOLD}%s КБ${NC}\n" "$SPACE_AFTER"
}

cmd_update() {
    if [ "$IS_YAM" = 1 ]; then
        CURR=$(get_current_version)
        printf "${BOLD}Пакет установлен через YAM v2 (${CYAN}horohi/soloist${NC}${BOLD}, текущая версия: %s).${NC}\n" "$CURR"
        printf "Для обновления используйте пакетный менеджер YAM:\n"
        printf "  ${CYAN}yam update && yam upgrade horohi/soloist${NC}\n"
        exit 0
    fi
    FORCE="${1:-}"
    CURR=$(get_current_version)
    printf "${BOLD}Проверка обновлений с GitHub (${GITHUB_REPO})...${NC}\n"

    LATEST_JSON=$("$CURL_BIN" -s "https://api.github.com/repos/$GITHUB_REPO/releases/latest" 2>/dev/null || true)
    LATEST=$(printf '%s\n' "$LATEST_JSON" | grep '"tag_name":' | head -n 1 | cut -d'"' -f4 || true)

    if [ -z "$LATEST" ]; then
        printf "${RED}Ошибка: Не удалось получить информацию о последнем релизе с GitHub.${NC}\n"
        exit 1
    fi

    printf "Текущая версия: ${BOLD}%s${NC}, последняя доступная: ${BOLD}${CYAN}%s${NC}\n" "$CURR" "$LATEST"

    if [ "$CURR" = "$LATEST" ] && [ "$FORCE" != "--force" ]; then
        printf "${GREEN}У вас уже установлена самая последняя версия!${NC}\n"
        printf "Для принудительной переустановки выполните: ${CYAN}soloist update --force${NC}\n"
        exit 0
    fi

    DOWNLOAD_URL="https://github.com/$GITHUB_REPO/releases/download/$LATEST/soloist-station-lite.tar.gz"

    # Stop current services safely (guard against legacy stop.sh running killall -9 soloist on ourselves)
    printf "Остановка старых служб...\n"
    if [ -f "$INSTALL_DIR/stop.sh" ]; then
        if grep -q '^killall -9 soloist ' "$INSTALL_DIR/stop.sh" 2>/dev/null; then
            sed 's/^killall -9 soloist /true /' "$INSTALL_DIR/stop.sh" | sh >/dev/null 2>&1 || true
        else
            "$INSTALL_DIR/stop.sh" >/dev/null 2>&1 || true
        fi
    fi

    # Backup existing configuration
    SAVED_CONF=""
    if [ -f "$INSTALL_DIR/spotify_api.conf" ]; then
        SAVED_CONF=$(cat "$INSTALL_DIR/spotify_api.conf")
    fi

    # Stream download and unpack directly into $INSTALL_DIR (0 MB RAM / 0 MB temp disk usage)
    printf "Загрузка и потоковая распаковка релиза %s...\n" "$LATEST"
    if ! "$CURL_BIN" -L -f -s "$DOWNLOAD_URL" | gzip -d -c 2>/dev/null | tar -xf - -C "$INSTALL_DIR" 2>/dev/null; then
        # Fallback if gzip -d failed: try gunzip
        if ! "$CURL_BIN" -L -f -s "$DOWNLOAD_URL" | gunzip -c 2>/dev/null | tar -xf - -C "$INSTALL_DIR" 2>/dev/null; then
            printf "${RED}Ошибка загрузки или распаковки архива с GitHub!${NC}\n"
            exit 1
        fi
    fi

    # Fix permissions and refresh top-level helper copies from scripts/
    [ ! -f "$INSTALL_DIR/scripts/stop.sh" ] || cp -f "$INSTALL_DIR/scripts/stop.sh" "$INSTALL_DIR/stop.sh" 2>/dev/null || true
    [ ! -f "$INSTALL_DIR/scripts/status.sh" ] || cp -f "$INSTALL_DIR/scripts/status.sh" "$INSTALL_DIR/status.sh" 2>/dev/null || true
    chmod 755 "$INSTALL_DIR/bin/"* "$INSTALL_DIR/scripts/"*.sh "$INSTALL_DIR/scripts/soloist-cli" "$INSTALL_DIR/stop.sh" "$INSTALL_DIR/status.sh" 2>/dev/null || true

    # Update CLI itself safely (atomic rename so running script is not truncated)
    if [ -f "$INSTALL_DIR/scripts/soloist-cli" ]; then
        cp -f "$INSTALL_DIR/scripts/soloist-cli" "$INSTALL_DIR/bin/soloist-cli.new"
        chmod 755 "$INSTALL_DIR/bin/soloist-cli.new"
        mv -f "$INSTALL_DIR/bin/soloist-cli.new" "$INSTALL_DIR/bin/soloist-cli"
        ln -sf "$INSTALL_DIR/bin/soloist-cli" /data/opt/bin/soloist 2>/dev/null || true
        ln -sf "$INSTALL_DIR/bin/soloist-cli" /data/opt/bin/soloistctl 2>/dev/null || true
    fi

    # Save version
    printf "%s\n" "$LATEST" > "$INSTALL_DIR/version"

    # Restore conf if needed
    if [ -n "$SAVED_CONF" ] && [ ! -s "$INSTALL_DIR/spotify_api.conf" ]; then
        printf "%s\n" "$SAVED_CONF" > "$INSTALL_DIR/spotify_api.conf"
        chmod 600 "$INSTALL_DIR/spotify_api.conf"
    fi

    # Cleanup any old update debris
    rm -rf /tmp/soloist_update* /data/local/tmp/soloist* 2>/dev/null || true

    # Restart
    printf "Запуск обновлённого Soloist...\n"
    sh "$INSTALL_DIR/start.sh"

    printf "\n${BOLD}${GREEN}Обновление до %s успешно завершено!${NC}\n" "$LATEST"
    printf "Временный мусор и архив автоматически очищены.\n"
}

trim_ws() {
    printf '%s\n' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

detect_station_model() {
    _compat=""
    if [ -f /proc/device-tree/compatible ]; then
        _compat=$(tr '\0' ' ' < /proc/device-tree/compatible 2>/dev/null || true)
    fi
    case "${YAM_PLATFORM:-}$_compat" in
        *yandexmicro*|*station-micro*|*micro*) printf 'Yandex Station Lite\n' ;;
        *yandexplum*|*plum*) printf 'Yandex Station Lite 2\n' ;;
        *yandexmini_2*|*station-mini2*) printf 'Yandex Station Mini 2\n' ;;
        *bergamot*|*station-mini3*) printf 'Yandex Station Mini 3\n' ;;
        *pickle*) printf 'Yandex Station Mini 3 Pro\n' ;;
        *yandexmini*|*station-mini*) printf 'Yandex Station Mini\n' ;;
        *yandexmidi*|*cucumber*|*amlogic,a5*|*amlogic,\ a5*) printf 'Yandex Station Midi\n' ;;
        *yandexstation_2*|*station-midi*|*midi*) printf 'Yandex Station 2\n' ;;
        *orion*) printf 'Yandex Station Max\n' ;;
        *) printf 'Yandex Station\n' ;;
    esac
}

normalize_playlist_uri() {
    _raw=$(trim_ws "$1")
    case "$_raw" in
        spotify:playlist:*)
            _pid="${_raw#spotify:playlist:}"
            _pid="${_pid%%\?*}"
            ;;
        *open.spotify.com/playlist/*)
            _pid="${_raw#*open.spotify.com/playlist/}"
            _pid="${_pid%%\?*}"
            _pid="${_pid%%/*}"
            ;;
        *) return 1 ;;
    esac
    case "$_pid" in
        ''|*[!A-Za-z0-9]*) return 1 ;;
    esac
    [ "${#_pid}" -eq 22 ] || return 1
    printf 'spotify:playlist:%s\n' "$_pid"
}

update_hosts_sni() {
    _enable="$1"
    _hosts="${SOLOIST_HOSTS_FILE:-/etc/hosts}"
    [ -e "$_hosts" ] || return 0

    _remounted=0
    if [ "$_hosts" = "/etc/hosts" ]; then
        mount -o remount,rw / 2>/dev/null && _remounted=1 || true
        if [ ! -f /etc/ssl/certs/ca-certificates.crt ] && [ -f /system/vendor/quasar/ca-certificates.crt ]; then
            mkdir -p /etc/ssl/certs
            ln -sf /system/vendor/quasar/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt 2>/dev/null || true
        fi
    fi

    if [ "$_enable" = "1" ]; then
        if ! grep -q "5.175.161.40" "$_hosts" 2>/dev/null; then
            cat << 'HOSTS_EOF' >> "$_hosts"

# Spotify SNI Proxy (Bypass 403 geoblock)
5.175.161.40 accounts.spotify.com
5.175.161.40 api.spotify.com
5.175.161.40 open.spotify.com
5.175.161.40 spclient.wg.spotify.com
HOSTS_EOF
        fi
    else
        sed -e '/^# Spotify SNI Proxy/d' -e '/^5\.175\.161\.40[[:space:]]/d' "$_hosts" > "$_hosts.tmp" 2>/dev/null \
            && chmod 644 "$_hosts.tmp" 2>/dev/null \
            && mv "$_hosts.tmp" "$_hosts" || rm -f "$_hosts.tmp"
    fi

    [ "$_remounted" = 0 ] || mount -o remount,ro / 2>/dev/null || true
}

cmd_setup() {
    printf "${BOLD}${GREEN}=== Мастер настройки Spotify Soloist ===${NC}\n\n"

    CURR_API_KEY=""
    CURR_DEVICE_NAME=""
    if [ "$IS_YAM" = 1 ] && [ -f "$CONF_DIR/config.env" ]; then
        . "$CONF_DIR/config.env" 2>/dev/null || true
        CURR_API_KEY="${API_KEY:-}"
        CURR_DEVICE_NAME="${DEVICE_NAME:-}"
    elif [ -f "$INSTALL_DIR/start.sh" ]; then
        CURR_API_KEY=$(grep -o 'API_KEY="[^"]*"' "$INSTALL_DIR/start.sh" 2>/dev/null | head -n 1 | cut -d'"' -f2 || true)
        CURR_DEVICE_NAME=$(grep -o -- '-n "[^"]*"' "$INSTALL_DIR/start.sh" 2>/dev/null | head -n 1 | cut -d'"' -f2 || true)
    fi
    [ "$CURR_API_KEY" != "dummy" ] || CURR_API_KEY=""

    CURR_CID=""
    CURR_CSECRET=""
    if [ -f "$CONF_DIR/spotify_api.conf" ]; then
        . "$CONF_DIR/spotify_api.conf" 2>/dev/null || true
        CURR_CID="${SPOTIFY_CLIENT_ID:-}"
        CURR_CSECRET="${SPOTIFY_CLIENT_SECRET:-}"
    fi

    CURR_FAV=""
    if [ -f "$DATA_ROOT/favorites.uri" ]; then
        CURR_FAV=$(trim_ws "$(cat "$DATA_ROOT/favorites.uri" 2>/dev/null || true)")
    fi

    # 1. Soloist API Key
    printf "${BOLD}1. Soloist API Key (Spotify Connect)${NC}\n"
    printf "   Получить можно (нужен Spotify Premium): ${CYAN}https://developer.spotify.com/dashboard/soloist${NC}\n"
    while true; do
        if [ -n "$CURR_API_KEY" ]; then
            _preview=$(printf '%s' "$CURR_API_KEY" | cut -c1-8)
            printf "   Введите API Key [Enter — оставить %s...]: " "$_preview"
        else
            printf "   Введите ваш API Key (spak_...): "
        fi
        _read_ok=1
        IFS= read -r _in_key || _read_ok=0
        _in_key=$(trim_ws "${_in_key:-}")
        if [ -z "$_in_key" ]; then
            if [ -n "$CURR_API_KEY" ]; then
                NEW_API_KEY="$CURR_API_KEY"
                break
            fi
            if [ "$_read_ok" = 0 ]; then
                printf "\n${RED}Ошибка: API Key не задан (EOF).${NC}\n" >&2
                exit 1
            fi
            printf "${RED}   API Key не может быть пустым.${NC}\n"
            continue
        fi
        case "$_in_key" in
            *[!A-Za-z0-9_-]*)
                printf "${RED}   Недопустимые символы в API Key (разрешены латиница, цифры, _ и -).${NC}\n"
                continue
                ;;
        esac
        NEW_API_KEY="$_in_key"
        break
    done
    printf "\n"

    # 2. Device Name
    DEFAULT_DEV="${CURR_DEVICE_NAME:-$(detect_station_model)}"
    printf "${BOLD}2. Имя колонки в приложении Spotify${NC}\n"
    while true; do
        printf "   Имя устройства [%s]: " "$DEFAULT_DEV"
        _read_ok=1
        IFS= read -r _in_dev || _read_ok=0
        _in_dev=$(trim_ws "${_in_dev:-}")
        [ -n "$_in_dev" ] || _in_dev="$DEFAULT_DEV"
        case "$_in_dev" in
            *[\"\$\`\\]*)
                if [ "$_read_ok" = 0 ]; then
                    printf "\n${RED}Ошибка: некорректное имя устройства (EOF).${NC}\n" >&2
                    exit 1
                fi
                printf "${RED}   Имя не должно содержать символы \" \$ \` или \\.${NC}\n"
                continue
                ;;
        esac
        NEW_DEVICE_NAME="$_in_dev"
        break
    done
    printf "\n"

    # 3. Spotify Web API Keys
    printf "${BOLD}3. Ключи Spotify Web API (для голосового поиска Алисы, опционально)${NC}\n"
    printf "   Создайте приложение на: ${CYAN}https://developer.spotify.com/dashboard${NC}\n"
    NEW_CID="$CURR_CID"
    NEW_CSECRET="$CURR_CSECRET"
    if [ -n "$CURR_CID" ] && [ -n "$CURR_CSECRET" ]; then
        _cid_prev=$(printf '%s' "$CURR_CID" | cut -c1-8)
        printf "   Client ID [Enter — оставить %s..., или 'clear' для очистки]: " "$_cid_prev"
    else
        printf "   Client ID [Enter — пропустить]: "
    fi
    IFS= read -r _in_cid || true
    _in_cid=$(trim_ws "${_in_cid:-}")
    if [ "$_in_cid" = "clear" ] || [ "$_in_cid" = "-" ]; then
        NEW_CID=""
        NEW_CSECRET=""
    elif [ -n "$_in_cid" ]; then
        case "$_in_cid" in
            *[!A-Za-z0-9_-]*)
                printf "${RED}   Некорректный Client ID — сохранён предыдущий.${NC}\n"
                ;;
            *)
                printf "   Client Secret: "
                IFS= read -r _in_sec || true
                _in_sec=$(trim_ws "${_in_sec:-}")
                case "$_in_sec" in
                    ''|*[!A-Za-z0-9_-]*)
                        printf "${YELLOW}   Некорректный или пустой Client Secret — Web API ключи не изменены.${NC}\n"
                        ;;
                    *)
                        NEW_CID="$_in_cid"
                        NEW_CSECRET="$_in_sec"
                        ;;
                esac
                ;;
        esac
    fi
    if [ -z "$NEW_CID" ] || [ -z "$NEW_CSECRET" ]; then
        printf "${YELLOW}   [!] Без ключей Web API голосовой поиск («Алиса, включи песню...») не работает,${NC}\n"
        printf "${YELLOW}       но воспроизведение через приложение Spotify (Connect) будет работать.${NC}\n"
    fi
    printf "\n"

    # 4. Liked Songs playlist URI
    printf "${BOLD}4. Плейлист «Любимые треки» / «Мне нравится» (опционально)${NC}\n"
    printf "   Можно вставить ссылку https://open.spotify.com/playlist/... или URI spotify:playlist:...\n"
    NEW_FAV="$CURR_FAV"
    while true; do
        if [ -n "$CURR_FAV" ]; then
            printf "   URI/ссылка [Enter — оставить %s, или 'clear']: " "$CURR_FAV"
        else
            printf "   URI/ссылка [Enter — пропустить]: "
        fi
        _read_ok=1
        IFS= read -r _in_fav || _read_ok=0
        _in_fav=$(trim_ws "${_in_fav:-}")
        if [ -z "$_in_fav" ]; then
            break
        elif [ "$_in_fav" = "clear" ] || [ "$_in_fav" = "-" ]; then
            NEW_FAV=""
            break
        elif _norm=$(normalize_playlist_uri "$_in_fav"); then
            NEW_FAV="$_norm"
            break
        else
            if [ "$_read_ok" = 0 ]; then
                printf "\n${RED}Ошибка: некорректный URI плейлиста (EOF).${NC}\n" >&2
                exit 1
            fi
            printf "${RED}   Не удалось распознать playlist URI/ссылку (нужен 22-символьный ID).${NC}\n"
        fi
    done
    printf "\n"

    # 5. SNI Proxy
    _hosts_file="${SOLOIST_HOSTS_FILE:-/etc/hosts}"
    _sni_on=0
    grep -q "5.175.161.40" "$_hosts_file" 2>/dev/null && _sni_on=1 || true
    printf "${BOLD}5. Встроенный SNI-прокси для обхода блокировки 403 (/etc/hosts)${NC}\n"
    if [ "$_sni_on" = 1 ]; then
        printf "   Сейчас прокси включён. Оставить включённым? [Y/n]: "
    else
        printf "   Включить встроенный SNI-прокси? [Y/n]: "
    fi
    IFS= read -r _in_sni || true
    case "$(trim_ws "${_in_sni:-}")" in
        [nN]|[nN][oO]|н|Н|нет|Нет) NEW_SNI=0 ;;
        *) NEW_SNI=1 ;;
    esac
    printf "\n"

    # Apply settings
    mkdir -p "$CONF_DIR" "$DATA_ROOT/requests"
    chmod 700 "$DATA_ROOT/requests" 2>/dev/null || true

    if [ "$IS_YAM" = 0 ] && [ -f "$INSTALL_DIR/start.sh" ]; then
        NEW_API_KEY="$NEW_API_KEY" NEW_DEVICE_NAME="$NEW_DEVICE_NAME" awk '
            /^API_KEY="/ { print "API_KEY=\"" ENVIRON["NEW_API_KEY"] "\""; next }
            /^[[:space:]]*-n ".*" \\$/ { sub(/-n "[^"]*"/, "-n \"" ENVIRON["NEW_DEVICE_NAME"] "\""); print; next }
            { print }
        ' "$INSTALL_DIR/start.sh" > "$INSTALL_DIR/start.sh.tmp" && \
            chmod 755 "$INSTALL_DIR/start.sh.tmp" && \
            mv -f "$INSTALL_DIR/start.sh.tmp" "$INSTALL_DIR/start.sh"
    else
        (
            umask 077
            cat > "$CONF_DIR/config.env" << EOF
API_KEY="$NEW_API_KEY"
DEVICE_NAME="$NEW_DEVICE_NAME"
EOF
            chmod 600 "$CONF_DIR/config.env" 2>/dev/null || true
        )
    fi

    if [ -n "$NEW_CID" ] && [ -n "$NEW_CSECRET" ]; then
        (
            umask 077
            cat > "$CONF_DIR/spotify_api.conf" << EOF
SPOTIFY_CLIENT_ID='$NEW_CID'
SPOTIFY_CLIENT_SECRET='$NEW_CSECRET'
EOF
            chmod 600 "$CONF_DIR/spotify_api.conf" 2>/dev/null || true
        )
    elif [ "$_in_cid" = "clear" ] || [ "$_in_cid" = "-" ]; then
        rm -f "$CONF_DIR/spotify_api.conf"
    fi

    if [ -n "$NEW_FAV" ]; then
        printf '%s\n' "$NEW_FAV" > "$DATA_ROOT/favorites.uri"
        chmod 600 "$DATA_ROOT/favorites.uri" 2>/dev/null || true
    else
        rm -f "$DATA_ROOT/favorites.uri"
    fi

    update_hosts_sni "$NEW_SNI"

    printf "${GREEN}Настройки сохранены!${NC}\n"
    printf "  Конфиг:  %s\n" "$CONF_DIR"
    printf "  Данные:  %s\n" "$DATA_ROOT"

    if [ "${SOLOIST_SETUP_NO_RESTART:-0}" != 1 ]; then
        printf "\n"
        cmd_restart
    fi
    printf "\nПроверить работу: ${CYAN}soloist status${NC}\n"
}

# Main entrypoint
case "${1:-}" in
    setup|configure|wizard)
        cmd_setup
        ;;
    status|st)
        cmd_status
        ;;
    led)
        shift
        cmd_led "$@"
        ;;
    restart|res)
        cmd_restart
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    logs|log)
        shift
        cmd_logs "$@"
        ;;
    clean|gc)
        cmd_clean
        ;;
    update|up)
        shift
        cmd_update "$@"
        ;;
    version|-v|--version)
        cmd_version
        ;;
    help|-h|--help|"")
        cmd_help
        ;;
    *)
        printf "${RED}Неизвестная команда: %s${NC}\n\n" "$1"
        cmd_help
        exit 1
        ;;
esac
