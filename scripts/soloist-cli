#!/bin/sh
# Soloist Management CLI for Yandex Station
# https://github.com/Horohi/soloist-station-lite

set -e

# Sanitize PATH
export PATH="/data/opt/bin:/opt/bin:/bin:/usr/bin:/sbin:/usr/sbin:$PATH"
unset LD_LIBRARY_PATH LD_PRELOAD

IS_YAM=0
if [ -n "${INSTALL_DIR:-}" ]; then
    case "$INSTALL_DIR" in */share/horohi.soloist) IS_YAM=1 ;; esac
elif [ -n "${YAM_PKG:-}" ] && [ -d "$YAM_PKG/share/horohi.soloist/bin" ]; then
    INSTALL_DIR="$YAM_PKG/share/horohi.soloist"
    IS_YAM=1
else
    _cli_parent="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)"
    _cli_real="$(readlink -f "$0" 2>/dev/null || true)"
    _cli_real_parent=""
    [ -z "$_cli_real" ] || _cli_real_parent="$(cd "$(dirname "$_cli_real")/.." 2>/dev/null && pwd)"

    if [ -d "$_cli_parent/share/horohi.soloist/bin" ]; then
        INSTALL_DIR="$_cli_parent/share/horohi.soloist"
        YAM_ROOT="$_cli_parent"
        IS_YAM=1
    elif [ -n "$_cli_real_parent" ] && [ -d "$_cli_real_parent/share/horohi.soloist/bin" ]; then
        INSTALL_DIR="$_cli_real_parent/share/horohi.soloist"
        IS_YAM=1
    elif [ -d "$_cli_parent/bin" ] && [ -f "$_cli_parent/scripts/control.sh" ]; then
        INSTALL_DIR="$_cli_parent"
        case "$INSTALL_DIR" in */share/horohi.soloist) IS_YAM=1 ;; esac
    elif [ -d "${YAM_ROOT:-/data/yam}/share/horohi.soloist/bin" ]; then
        INSTALL_DIR="${YAM_ROOT:-/data/yam}/share/horohi.soloist"
        IS_YAM=1
    else
        INSTALL_DIR="/data/opt/soloist"
    fi
fi

if [ "$IS_YAM" = 1 ]; then
    if [ -z "${YAM_ROOT:-}" ]; then
        case "$INSTALL_DIR" in
            */pkgs/horohi/soloist/*/share/horohi.soloist) YAM_ROOT="${INSTALL_DIR%/pkgs/horohi/soloist/*/share/horohi.soloist}" ;;
            */share/horohi.soloist) YAM_ROOT="${INSTALL_DIR%/share/horohi.soloist}" ;;
            *) YAM_ROOT="/data/yam" ;;
        esac
    fi
    _var_base="${YAM_VAR:-$YAM_ROOT/var}"
    _etc_base="${YAM_ETC:-$YAM_ROOT/etc}"
    if [ "$YAM_ROOT" != "/data/yam" ]; then
        [ "$_var_base" != "/data/yam/var" ] || _var_base="$YAM_ROOT/var"
        [ "$_etc_base" != "/data/yam/etc" ] || _etc_base="$YAM_ROOT/etc"
    fi
    DATA_ROOT="$_var_base/horohi.soloist"
    CONF_DIR="$_etc_base/horohi.soloist"
    CACHE_DIR="${SOLOIST_CACHE_DIR:-${YAM_RUN:-/tmp}/soloist_cache}"
else
    DATA_ROOT="$INSTALL_DIR/data"
    CONF_DIR="$INSTALL_DIR"
    CACHE_DIR="${SOLOIST_CACHE_DIR:-/tmp/soloist_cache}"
fi

CURL_BIN="$INSTALL_DIR/bin/curl"
[ -x "$CURL_BIN" ] || CURL_BIN="curl"

GITHUB_REPO="Horohi/soloist-station-lite"

# Colors (if terminal supports it)
if [ -t 1 ]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    BOLD='\033[1m'
    NC='\033[0m'
else
    RED='' GREEN='' YELLOW='' BLUE='' CYAN='' BOLD='' NC=''
fi

cmd_help() {
    printf "${BOLD}${GREEN}Spotify Soloist CLI для Яндекс Станции${NC}\n"
    printf "Использование: ${CYAN}soloist <команда>${NC}\n\n"
    printf "${BOLD}Команды управления:${NC}\n"
    printf "  ${CYAN}setup${NC}        Интерактивный мастер настройки ключей API, имени колонки и SNI-прокси\n"
    printf "  ${CYAN}status${NC}       Статус плеера, моста, памяти, подсветки и текущего трека\n"
    printf "  ${CYAN}network${NC} [status|auto|off|check]  Управление SNI-прокси Spotify\n"
    printf "  ${CYAN}doctor${NC} [--offline]  Диагностика для отчёта об ошибке\n"
    printf "  ${CYAN}led${NC} [on|off|white|rainbow|cyan|green|fx on|fx off|status]  Управление подсветкой и анимациями\n"
    printf "  ${CYAN}restart${NC}      Перезапустить службу Spotify и мост управления\n"
    printf "  ${CYAN}start${NC}        Запустить службу\n"
    printf "  ${CYAN}stop${NC}         Остановить службу\n"
    printf "  ${CYAN}logs${NC} [bridge] Показать логи в реальном времени (по умолч. soloist, 'bridge' — мост)\n\n"
    printf "${BOLD}Обслуживание и диск:${NC}\n"
    printf "  ${CYAN}update${NC} [--force]  Обновить Soloist до свежего релиза с GitHub в 1 команду\n"
    printf "  ${CYAN}clean${NC}        Очистить кэш, старые логи и мусор в /data/local/tmp\n"
    printf "  ${CYAN}version${NC}      Показать текущую версию и доступную на GitHub\n"
    printf "\n"
}

get_current_version() {
    if [ -f "$INSTALL_DIR/version" ]; then
        cat "$INSTALL_DIR/version"
    elif [ -f "$INSTALL_DIR/README.md" ]; then
        grep -o 'v1\.[0-9]\+\.[0-9]\+' "$INSTALL_DIR/README.md" 2>/dev/null | head -n 1 || echo "v1.x"
    else
        echo "v1.x"
    fi
}

cmd_version() {
    CURR=$(get_current_version)
    printf "Установленная версия: ${BOLD}${GREEN}%s${NC}\n" "$CURR"
    printf "Проверка обновлений на GitHub... "
    LATEST=$("$CURL_BIN" -s "https://api.github.com/repos/$GITHUB_REPO/releases/latest" 2>/dev/null | grep '"tag_name":' | head -n 1 | cut -d'"' -f4 || true)
    if [ -n "$LATEST" ]; then
        printf "Последняя версия: ${BOLD}${CYAN}%s${NC}\n" "$LATEST"
        if [ "$CURR" = "$LATEST" ]; then
            printf "${GREEN}У вас установлена самая актуальная версия!${NC}\n"
        else
            printf "${YELLOW}Доступно обновление! Запустите: soloist update${NC}\n"
        fi
    else
        printf "${RED}Не удалось подключиться к GitHub API${NC}\n"
    fi
}

find_live_pid() {
    _proc="$1"
    for _p in $(pidof "$_proc" 2>/dev/null || true) $(cat "$DATA_ROOT/${_proc}.pid" 2>/dev/null || true) $(cat "$CACHE_DIR/${_proc}.pid" 2>/dev/null || true); do
        [ -n "$_p" ] && [ "$_p" != "$$" ] && [ "$_p" != "${PPID:-0}" ] && kill -0 "$_p" 2>/dev/null || continue
        _exe=$(readlink "/proc/$_p/exe" 2>/dev/null || true)
        case "$_exe" in
            */busybox|*/sh|*/ash|*/dash|*/bash) continue ;;
        esac
        _comm=$(cat "/proc/$_p/comm" 2>/dev/null || true)
        if [ "$_comm" = "$_proc" ]; then
            printf '%s\n' "$_p"
            return 0
        elif [ "$_proc" = "soloist" ] && [ "$_comm" = "ld-linux-aarch6" ]; then
            case "$(tr '\0' ' ' < "/proc/$_p/cmdline" 2>/dev/null || true)" in
                *soloist*) printf '%s\n' "$_p"; return 0 ;;
            esac
        fi
    done
    return 1
}

run_soloist_ctl() {
    _bin="$INSTALL_DIR/bin/soloist"
    _lib="$INSTALL_DIR/lib64"
    _ld="$_lib/ld-linux-aarch64.so.1"
    if [ -x "$_ld" ] && ! LD_LIBRARY_PATH="$_lib" "$_bin" --help >/dev/null 2>&1; then
        LD_LIBRARY_PATH="$_lib" "$_ld" --library-path "$_lib" --argv0 "$_bin" "$_bin" "$@"
    else
        LD_LIBRARY_PATH="$_lib" "$_bin" "$@"
    fi
}

cmd_status() {
    printf "${BOLD}=== Spotify Soloist Status ===${NC}\n"

    # Soloist daemon
    SOLO_PID=$(find_live_pid soloist || true)
    if [ -n "$SOLO_PID" ]; then
        RSS_KB=$(awk '/VmRSS/{print $2}' "/proc/$SOLO_PID/status" 2>/dev/null || echo "0")
        RSS_MB=$((RSS_KB / 1024))
        printf "  Soloist Daemon: ${GREEN}RUNNING${NC} (PID: %s, RAM: %s MB)\n" "$SOLO_PID" "$RSS_MB"
    else
        printf "  Soloist Daemon: ${RED}STOPPED${NC}\n"
    fi

    # Bridge daemon
    BRIDGE_PID=$(find_live_pid soloist-bridge || true)
    if [ -n "$BRIDGE_PID" ]; then
        BR_RSS=$(awk '/VmRSS/{print $2}' "/proc/$BRIDGE_PID/status" 2>/dev/null || echo "0")
        printf "  Soloist Bridge: ${GREEN}RUNNING${NC} (PID: %s, RAM: %s KB)\n" "$BRIDGE_PID" "$BR_RSS"
    else
        printf "  Soloist Bridge: ${RED}STOPPED${NC}\n"
    fi

    # LED visualizer & animations state
    if [ -f "$DATA_ROOT/requests/led_state" ]; then
        LED_ST=$(cat "$DATA_ROOT/requests/led_state" 2>/dev/null || echo "off")
        if [ "$LED_ST" = "on" ]; then
            printf "  Светомузыка:    ${GREEN}ВКЛЮЧЕНА (Nothing Phone / Equalizer)${NC}\n"
        else
            printf "  Светомузыка:    ${YELLOW}ВЫКЛЮЧЕНА${NC}\n"
        fi
    fi
    if [ "$(read_led_fx_state)" = "on" ]; then
        printf "  Анимации LED:   ${GREEN}ВКЛЮЧЕНЫ${NC}\n"
    else
        printf "  Анимации LED:   ${YELLOW}ВЫКЛЮЧЕНЫ${NC}\n"
    fi

    # Soloist API status
    if [ -x "$INSTALL_DIR/bin/soloist" ]; then
        STATUS_OUT=$(run_soloist_ctl ctl -w 127.0.0.1:9090 status 2>/dev/null || true)
        if [ -n "$STATUS_OUT" ]; then
            printf "\n${BOLD}Spotify API & Сессия:${NC}\n"
            printf "%s\n" "$STATUS_OUT" | sed 's/^/  /'
        fi
    fi

    # Current Track
    if [ -f "$DATA_ROOT/requests/track" ]; then
        TRACK_URI=$(head -n 1 "$DATA_ROOT/requests/track" 2>/dev/null || true)
        if [ -n "$TRACK_URI" ]; then
            printf "  Текущий трек:   ${CYAN}%s${NC}\n" "$TRACK_URI"
        fi
    fi

    if [ "$IS_YAM" = 1 ]; then
        printf "\n${BOLD}YAM v2 Пути:${NC}\n"
        printf "  Конфиг: %s\n" "$CONF_DIR"
        printf "  Данные: %s\n" "$DATA_ROOT"
    fi

    # Memory
    printf "\n${BOLD}Память и диск:${NC}\n"
    free -m 2>/dev/null | awk 'NR<=2{printf "  %s\n", $0}' || true
    df -h /data 2>/dev/null | awk 'NR<=2{printf "  %s\n", $0}' || true
}

doctor_has_key() {
    [ -r "$1" ] || return 1
    LC_ALL=C awk -v key="$2" '
        $0 ~ "^[ \t]*" key "=" {
            value = substr($0, index($0, "=") + 1)
            if (value ~ /^"[^"]*"$/ || value ~ /^\047[^\047]*\047$/)
                value = substr(value, 2, length(value) - 2)
            present = value ~ /^[A-Za-z0-9_-]+$/ && value != "dummy"
        }
        END {exit !present}
    ' "$1" 2>/dev/null
}

read_network_mode() {
    _net_conf="$CONF_DIR/spotify-network.conf"
    [ -f "$_net_conf" ] || _net_conf="${SOLOIST_NET_CONF:-$_net_conf}"
    if [ -f "$_net_conf" ]; then
        _net_mode=$(sed -n 's/^SOLOIST_NETWORK_MODE="\{0,1\}\([a-z]*\)"\{0,1\}$/\1/p' "$_net_conf" 2>/dev/null | head -n 1 || true)
        printf '%s\n' "${_net_mode:-default}"
    else
        printf 'default\n'
    fi
}

read_network_proxy() {
    _hosts="${SOLOIST_HOSTS_FILE:-/etc/hosts}"
    if [ -f "$INSTALL_DIR/scripts/spotify-network.sh" ]; then
        SOLOIST_NET_BASE="$INSTALL_DIR" SOLOIST_NET_STATE="$DATA_ROOT" SOLOIST_NET_CONF="$CONF_DIR/spotify-network.conf" \
            sh "$INSTALL_DIR/scripts/spotify-network.sh" current 2>/dev/null || true
    else
        awk '/^# BEGIN SOLOIST SPOTIFY PROXY$/{m=1;next} /^# END SOLOIST SPOTIFY PROXY$/{m=0;next}
             m && $2=="api.spotify.com"{print $1; exit}' "$_hosts" 2>/dev/null || true
    fi
}

doctor_events() {
    # Emit known events instead of the voice requests and other data in raw logs.
    _soloist_log="${SOLOIST_LOG_FILE:-/tmp/soloist.log}"
    {
        tail -n 120 /tmp/soloist-bridge.log 2>/dev/null || true
        tail -n 120 /tmp/soloist-search.log 2>/dev/null || true
        tail -n 120 "$_soloist_log" 2>/dev/null || true
        tail -n 120 "$DATA_ROOT/requests/control.log" 2>/dev/null || true
    } | LC_ALL=C awk '
        /^\[bridge\] Connected to Quasar on 127\.0\.0\.1:9875$/ {print "quasar_connected"}
        /^\[bridge\] Connected to Quasar Volume state on 127\.0\.0\.1:9921$/ {print "quasar_volume_connected"}
        /^\[bridge\] Quasar (socket error|connection closed), reconnecting\.\.\.$/ {print "quasar_reconnecting"}
        /^\[bridge\] Quasar 9910 volume_set unconfirmed on 9921; falling back to ALSA amixer volume$/ {print "quasar_volume_fallback_amixer"}
        /^\[bridge\] Alice TTS cancelled: ALSA SHM still present or inaccessible$/ {print "tts_waiting_for_alsa"}
        /^\[bridge\] Action: PLAYLIST SEARCH$/ {print "playlist_request"}
        /^\[bridge\] (Voice command triggered:|Action: SEARCH & PLAY query=)/ {print "voice_activity"}
        /^\[search\] (Playlist name not found or ambiguous|No usable match); playback unchanged$/ {print "catalog_no_match"}
        /^\[search\] Cannot filter explicit tracks in a (playlist context|album or artist context); playback unchanged$/ {print "catalog_censorship"}
        /^\[search\] HTTP transport failed; playback unchanged$/ {print "spotify_transport_failed"}
        /^\[search\] HTTP [1-5][0-9][0-9]; playback unchanged$/ {print "spotify_http_" substr($3, 1, 3)}
        /^\[search\] Spotify cooldown active; request discarded$/ {print "spotify_rate_limited"}
        /^\[control\] action=(play|pause|next|prev|toggle|seek|volume|repeat|shuffle|auto-next|auto-repeat|radio) stage=(admission|now|activate|selection|dispatch) status=[0-9][0-9]?[0-9]?$/ {
            print "control_failure", $2, $3, $4
        }
        {
            low = tolower($0)
            if (low !~ /^\[bridge\]/ && low !~ /^\[search\]/ && low !~ /^\[control\]/) {
                if (low ~ /(access token|client token|login|auth|credential).*(fail|error|denied|invalid|401|403)|logged in:[ \t]*no/) {
                    print "soloist_auth_failed"
                } else if (low ~ /(tls|ssl|certificate|handshake)/ && low ~ /(fail|error|verify|unable)/) {
                    print "soloist_tls_error"
                } else if (low ~ /(resolve|dns|name resolution|getaddrinfo|could not resolve)/ && low ~ /(fail|error)/) {
                    print "soloist_dns_error"
                } else if (low ~ /(403 forbidden|http[^0-9]*403)/) {
                    print "soloist_http_403"
                } else if (low ~ /(connect|connection|socket|spclient|accesspoint).*(fail|error|refused|timed out|timeout|reset)/) {
                    print "soloist_connect_failed"
                }
            }
        }
    ' | tail -n 16
}

cmd_doctor() {
    case "${1:-}" in
        ""|--offline) ;;
        *) printf 'Использование: soloist doctor [--offline]\n' >&2; return 2 ;;
    esac
    local model firmware version mode player bridge cards master shm hook api_config soloist_config http events net_mode net_proxy session_out
    model=$(detect_station_model)
    firmware=$(LC_ALL=C awk 'NR == 1 && $1 ~ /^[0-9]+(\.[0-9]+)+$/ {print $1}' \
        /system/vendor/quasar/version_full 2>/dev/null || true)
    if [ -z "$firmware" ] && command -v getprop >/dev/null 2>&1; then
        firmware=$(getprop ro.build.version.incremental 2>/dev/null || true)
        case "$firmware" in *[!0-9A-Za-z._+-]*) firmware="" ;; esac
    fi
    version=$(get_current_version)
    case "$version" in *[!0-9vx.]*) version="" ;; esac
    mode=Standalone
    [ "$IS_YAM" = 0 ] || mode='YAM v2'
    printf 'Soloist %s (%s)\n' "${version:-unknown}" "$mode"
    printf 'Device: %s\nFirmware: %s\nKernel: %s %s\n' \
        "$model" "${firmware:-unknown}" "$(uname -r)" "$(uname -m)"

    player=$(find_live_pid soloist || true)
    bridge=$(find_live_pid soloist-bridge || true)
    if [ -n "$player" ]; then printf 'Soloist process: running\n'; else printf 'Soloist process: stopped\n'; fi
    if [ -n "$bridge" ]; then printf 'Bridge process: running\n'; else printf 'Bridge process: stopped\n'; fi
    if [ -z "$player" ]; then
        printf 'Soloist session: unavailable (player stopped)\n'
    elif [ -x "$INSTALL_DIR/bin/soloist" ]; then
        session_out=$(run_soloist_ctl ctl -w 127.0.0.1:9090 status 2>/dev/null || true)
        case "$session_out" in
            *'logged in: yes'*) printf 'Soloist session: logged in\n' ;;
            *'logged in: no'*) printf 'Soloist session: not logged in\n' ;;
            *) printf 'Soloist session: unknown\n' ;;
        esac
    else
        printf 'Soloist session: unknown\n'
    fi
    soloist_config="$CONF_DIR/config.env"
    [ "$IS_YAM" = 1 ] || soloist_config="$INSTALL_DIR/start.sh"
    if doctor_has_key "$soloist_config" API_KEY; then
        printf 'Soloist key: configured\n'
    else
        printf 'Soloist key: missing\n'
    fi
    api_config="$CONF_DIR/spotify_api.conf"
    [ -f "$api_config" ] || api_config="$INSTALL_DIR/spotify_api.conf"
    if doctor_has_key "$api_config" SPOTIFY_CLIENT_ID && doctor_has_key "$api_config" SPOTIFY_CLIENT_SECRET; then
        printf 'Spotify Web API keys: configured\n'
    else
        printf 'Spotify Web API keys: missing\n'
    fi
    net_mode=$(read_network_mode)
    net_proxy=$(read_network_proxy)
    printf 'Spotify network mode: %s\n' "${net_mode:-default}"
    printf 'Spotify hosts proxy: %s\n' "${net_proxy:-none}"
    if [ "${1:-}" = --offline ]; then
        printf 'Spotify API reachability: skipped\n'
    elif http=$("$CURL_BIN" -q --noproxy '*' -sS -o /dev/null --connect-timeout 2 --max-time 4 \
        -w '%{http_code}' 'https://api.spotify.com/v1/me' 2>/dev/null); then
        case "$http" in
            401|200) printf 'Spotify API reachability: reachable (HTTP %s without credentials)\n' "$http" ;;
            [1-5][0-9][0-9]) printf 'Spotify API reachability: HTTP %s\n' "$http" ;;
            *) printf 'Spotify API reachability: unknown\n' ;;
        esac
    else
        printf 'Spotify API reachability: connection failed\n'
    fi

    cards=$(LC_ALL=C awk -F '[][]' 'NF >= 3 {id=$2; gsub(/[ \t]/,"",id); if (id ~ /^[A-Za-z0-9_-]+$/) print id}' \
        /proc/asound/cards 2>/dev/null || true)
    printf 'ALSA cards: %s\n' "${cards:-unavailable}"
    master=$({
        if command -v timeout >/dev/null 2>&1; then
            timeout 3 amixer get Master
        elif command -v amixer >/dev/null 2>&1; then
            amixer get Master
        fi
    } 2>/dev/null | LC_ALL=C awk '
        /Playback [0-9]+ \[/ {for (i=1; i<=NF; i++) if ($i ~ /^\[[0-9]+%\]$/) printf "%s ", $i}
    ')
    printf 'ALSA Master: %s\n' "${master:-unavailable}"
    shm=$(awk '$1 == 1024 && $4 ~ /^[0-9]+$/ {print $4; exit}' /proc/sysvipc/shm 2>/dev/null || true)
    printf 'ALSA SHM 1024 bytes: %s\n' "${shm:-not observed}"
    hook='not observed'
    if [ -n "$player" ] && grep -q '/libsoloist_duck\.so$' "/proc/$player/maps" 2>/dev/null; then hook=loaded; fi
    printf 'ALSA ducking hook: %s\n' "$hook"
    if [ -e /tmp/soloist.yield ]; then printf 'ALSA yield marker: present\n'; else printf 'ALSA yield marker: absent\n'; fi

    events=$(doctor_events)
    printf 'Recent diagnostic events:\n%s\n' "${events:-none}"
}

read_led_fx_state() {
    _fx_state_f="$DATA_ROOT/requests/led_fx_state"
    if [ -f "$_fx_state_f" ]; then
        case "$(cat "$_fx_state_f" 2>/dev/null || true)" in
            *off*) printf 'off\n'; return 0 ;;
            *on*)  printf 'on\n'; return 0 ;;
        esac
    fi
    _fx_conf="$CONF_DIR/spotify_api.conf"
    if [ -f "$_fx_conf" ]; then
        _fx_val=$(awk -F= '/^[ \t]*(LED_ANIMATIONS|LED_FX)=/{
            v=$2; sub(/[ \t]*#.*/, "", v); gsub(/["'\'' \t\r]/, "", v); val=v
        } END { print val }' "$_fx_conf" 2>/dev/null || true)
        case "$_fx_val" in
            [oO][fF][fF]|0) printf 'off\n'; return 0 ;;
            [oO][nN]|1)  printf 'on\n'; return 0 ;;
        esac
    fi
    printf 'on\n'
}

cmd_led() {
    ACTION="${1:-status}"
    SUB="${2:-status}"
    REQ_FILE="$DATA_ROOT/requests/led"
    STATE_FILE="$DATA_ROOT/requests/led_state"
    mkdir -p "$DATA_ROOT/requests"

    case "$ACTION" in
        on|1)
            printf "1\n" > "$REQ_FILE"
            printf "${GREEN}Эквалайзер / Светомузыка включена! (Nothing Phone style)${NC}\n"
            ;;
        off|0)
            printf "0\n" > "$REQ_FILE"
            printf "${YELLOW}Эквалайзер / Светомузыка выключена.${NC}\n"
            ;;
        white|w)
            printf "w\n" > "$REQ_FILE"
            printf "${BOLD}Цвет эквалайзера: Белый (Nothing Phone style)${NC}\n"
            ;;
        rainbow|r)
            printf "r\n" > "$REQ_FILE"
            printf "${BOLD}${CYAN}Цвет эквалайзера: Радуга (Rainbow)${NC}\n"
            ;;
        cyan|c)
            printf "c\n" > "$REQ_FILE"
            printf "${BOLD}${CYAN}Цвет эквалайзера: Бирюзовый (Cyan)${NC}\n"
            ;;
        green|spotify|g)
            printf "g\n" > "$REQ_FILE"
            printf "${BOLD}${GREEN}Цвет эквалайзера: Зелёный (Spotify)${NC}\n"
            ;;
        fx|anim|animations)
            case "$SUB" in
                on|1)
                    printf "f1\n" > "$REQ_FILE"
                    printf "${GREEN}Анимации LED-кольца включены.${NC}\n"
                    ;;
                off|0)
                    printf "f0\n" > "$REQ_FILE"
                    printf "${YELLOW}Анимации LED-кольца выключены.${NC}\n"
                    ;;
                status|state)
                    if [ "$(read_led_fx_state)" = "on" ]; then
                        printf "Статус анимаций LED: ${BOLD}${GREEN}ВКЛЮЧЕНЫ${NC}\n"
                    else
                        printf "Статус анимаций LED: ${BOLD}${YELLOW}ВЫКЛЮЧЕНЫ${NC}\n"
                    fi
                    ;;
                *)
                    printf "Использование: soloist led fx [on|off|status]\n"
                    return 2
                    ;;
            esac
            ;;
        fx-on|anim-on)
            printf "f1\n" > "$REQ_FILE"
            printf "${GREEN}Анимации LED-кольца включены.${NC}\n"
            ;;
        fx-off|anim-off)
            printf "f0\n" > "$REQ_FILE"
            printf "${YELLOW}Анимации LED-кольца выключены.${NC}\n"
            ;;
        status|state)
            if [ -f "$STATE_FILE" ]; then
                ST=$(cat "$STATE_FILE" 2>/dev/null || echo "off")
                if [ "$ST" = "on" ]; then
                    printf "Статус светомузыки: ${BOLD}${GREEN}ВКЛЮЧЕНА (Nothing Phone / Equalizer)${NC}\n"
                else
                    printf "Статус светомузыки: ${BOLD}${YELLOW}ВЫКЛЮЧЕНА${NC}\n"
                fi
            else
                printf "Статус светомузыки: ${BOLD}${GREEN}ВКЛЮЧЕНА (по умолчанию: Белый)${NC}\n"
            fi
            if [ "$(read_led_fx_state)" = "on" ]; then
                printf "Анимации событий:   ${BOLD}${GREEN}ВКЛЮЧЕНЫ${NC}\n"
            else
                printf "Анимации событий:   ${BOLD}${YELLOW}ВЫКЛЮЧЕНЫ${NC}\n"
            fi
            ;;
        *)
            printf "Использование: soloist led [on|off|white|rainbow|cyan|green|fx on|fx off|status]\n"
            ;;
    esac
}

cmd_restart() {
    printf "Перезапуск Spotify Soloist...\n"
    if [ "$IS_YAM" = 1 ]; then
        YAM_ROOT="$YAM_ROOT" YAM_VAR="${YAM_VAR:-$YAM_ROOT/var}" YAM_ETC="${YAM_ETC:-$YAM_ROOT/etc}" \
            sh "$INSTALL_DIR/scripts/yam-init.sh" restart
    else
        "$INSTALL_DIR/stop.sh" >/dev/null 2>&1 || true
        sleep 1
        sh "$INSTALL_DIR/start.sh"
    fi
    printf "${GREEN}Готово! Служба перезапущена.${NC}\n"
}

cmd_start() {
    printf "Запуск Spotify Soloist...\n"
    if [ "$IS_YAM" = 1 ]; then
        YAM_ROOT="$YAM_ROOT" YAM_VAR="${YAM_VAR:-$YAM_ROOT/var}" YAM_ETC="${YAM_ETC:-$YAM_ROOT/etc}" \
            sh "$INSTALL_DIR/scripts/yam-init.sh" start
    else
        sh "$INSTALL_DIR/start.sh"
    fi
    printf "${GREEN}Запущено.${NC}\n"
}

cmd_stop() {
    printf "Остановка Spotify Soloist...\n"
    if [ "$IS_YAM" = 1 ]; then
        YAM_ROOT="$YAM_ROOT" YAM_VAR="${YAM_VAR:-$YAM_ROOT/var}" YAM_ETC="${YAM_ETC:-$YAM_ROOT/etc}" \
            sh "$INSTALL_DIR/scripts/yam-init.sh" stop
    else
        "$INSTALL_DIR/stop.sh"
    fi
    printf "${YELLOW}Остановлено.${NC}\n"
}

cmd_logs() {
    LOG_FILE="/tmp/soloist.log"
    if [ "${1:-}" = "bridge" ] || [ "${1:-}" = "b" ]; then
        LOG_FILE="/tmp/soloist-bridge.log"
    elif [ "${1:-}" = "search" ] || [ "${1:-}" = "s" ]; then
        LOG_FILE="/tmp/soloist-search.log"
    fi

    if [ ! -f "$LOG_FILE" ]; then
        printf "${RED}Файл логов %s пока не создан.${NC}\n" "$LOG_FILE"
        exit 0
    fi

    printf "${CYAN}=== Просмотр логов: %s (Ctrl+C для выхода) ===${NC}\n" "$LOG_FILE"
    tail -n 40 -f "$LOG_FILE"
}

cmd_clean() {
    printf "${BOLD}Очистка временных файлов и мусора...${NC}\n"
    SPACE_BEFORE=$(df /data | awk 'NR==2 {print $4}')

    # 1. Clean installer leftover in /data/local/tmp
    rm -rf /data/local/tmp/soloist_update* /data/local/tmp/*.tar.gz 2>/dev/null || true

    # 2. Clean bloated logs in /tmp
    for l in /tmp/soloist.log /tmp/soloist-bridge.log /tmp/soloist-search.log; do
        if [ -f "$l" ]; then
            tail -n 100 "$l" > "$l.tmp" 2>/dev/null && mv "$l.tmp" "$l" 2>/dev/null || true
        fi
    done

    # 3. Clean old audio stream chunks from cache (BusyBox find compatible)
    if [ -x "$INSTALL_DIR/scripts/control.sh" ]; then
        SOLOIST_CACHE_DIR="$CACHE_DIR/cache" sh "$INSTALL_DIR/scripts/control.sh" clean-cache 2>/dev/null || true
    elif [ -d "$CACHE_DIR/cache" ]; then
        find "$CACHE_DIR/cache" -type f -mmin +1 -exec rm -f {} + 2>/dev/null || true
    fi

    # 4. Clean update leftovers in /bkupgrade
    rm -f /bkupgrade/update_* /bkupgrade/ota/* /bkupgrade/uImage* 2>/dev/null || true

    # 5. Clean bak files
    rm -f "$INSTALL_DIR"/*.bak "$INSTALL_DIR"/*.tmp 2>/dev/null || true

    # 6. Ensure Storage cache lives in RAM tmpfs to protect flash memory
    mkdir -p "$CACHE_DIR/Storage" "$DATA_ROOT/cache"
    if [ ! -L "$DATA_ROOT/cache/Storage" ]; then
        rm -rf "$DATA_ROOT/cache/Storage" 2>/dev/null || true
        ln -sfn "$CACHE_DIR/Storage" "$DATA_ROOT/cache/Storage" 2>/dev/null || true
    fi

    # 7. Drop inactive kernel page cache to free RAM
    sync && echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || true

    SPACE_AFTER=$(df /data | awk 'NR==2 {print $4}')
    DIFF=$((SPACE_AFTER - SPACE_BEFORE))
    if [ "$DIFF" -gt 0 ]; then
        printf "${GREEN}Успешно! Освобождено в /data: %s КБ (~%s МБ)${NC}\n" "$DIFF" "$((DIFF / 1024))"
    else
        printf "${GREEN}Мусора не обнаружено, система чистая.${NC}\n"
    fi
    printf "Свободно в /data: ${BOLD}%s КБ${NC}\n" "$SPACE_AFTER"
}

cmd_update() {
    if [ -x /system/bin/getprop ] &&
       [ "$(/system/bin/getprop ro.product.device 2>/dev/null || true)" = yandexstation_2 ]; then
        printf 'Для Станции Макс требуется обновление через её Android-комплект.\n' >&2
        return 1
    fi
    if [ "$IS_YAM" = 1 ]; then
        CURR=$(get_current_version)
        printf "${BOLD}Пакет установлен через YAM v2 (${CYAN}horohi/soloist${NC}${BOLD}, текущая версия: %s).${NC}\n" "$CURR"
        printf "Для обновления используйте пакетный менеджер YAM:\n"
        printf "  ${CYAN}yam update && yam upgrade horohi/soloist${NC}\n"
        exit 0
    fi
    FORCE="${1:-}"
    CURR=$(get_current_version)
    printf "${BOLD}Проверка обновлений с GitHub (${GITHUB_REPO})...${NC}\n"

    LATEST_JSON=$("$CURL_BIN" -s "https://api.github.com/repos/$GITHUB_REPO/releases/latest" 2>/dev/null || true)
    LATEST=$(printf '%s\n' "$LATEST_JSON" | grep '"tag_name":' | head -n 1 | cut -d'"' -f4 || true)

    if [ -z "$LATEST" ]; then
        printf "${RED}Ошибка: Не удалось получить информацию о последнем релизе с GitHub.${NC}\n"
        exit 1
    fi

    printf "Текущая версия: ${BOLD}%s${NC}, последняя доступная: ${BOLD}${CYAN}%s${NC}\n" "$CURR" "$LATEST"

    if [ "$CURR" = "$LATEST" ] && [ "$FORCE" != "--force" ]; then
        printf "${GREEN}У вас уже установлена самая последняя версия!${NC}\n"
        printf "Для принудительной переустановки выполните: ${CYAN}soloist update --force${NC}\n"
        exit 0
    fi

    DOWNLOAD_URL="https://github.com/$GITHUB_REPO/releases/download/$LATEST/soloist-station-lite.tar.gz"

    # Validate the complete download before stopping the old service. Keep
    # only the compressed archive: the speaker may have little free space.
    UPDATE_DIR=$(mktemp -d "$INSTALL_DIR/.soloist-update.XXXXXX") || {
        printf "${RED}Ошибка: не удалось создать временный каталог обновления.${NC}\n"
        exit 1
    }
    trap 'rm -rf "$UPDATE_DIR"' EXIT
    trap 'exit 1' HUP INT TERM
    printf "Загрузка и проверка релиза %s...\n" "$LATEST"
    if ! "$CURL_BIN" -L -f -s --connect-timeout 10 --max-time 300 -o "$UPDATE_DIR/release.tar.gz" "$DOWNLOAD_URL" ||
       ! gzip -t "$UPDATE_DIR/release.tar.gz" 2>/dev/null ||
       ! gzip -dc "$UPDATE_DIR/release.tar.gz" | tar -tf - > "$UPDATE_DIR/files" 2>/dev/null; then
        printf "${RED}Ошибка загрузки или проверки архива; текущая установка сохранена.${NC}\n"
        exit 1
    fi
    for required in bin/soloist bin/soloist-bridge bin/curl lib64/ld-linux-aarch64.so.1 \
                    scripts/soloist-cli scripts/control.sh scripts/request_state.sh scripts/search_and_play.sh scripts/stop.sh scripts/status.sh \
                    scripts/soloist-ram-guard.sh scripts/migrate-standalone-guard.sh scripts/migrate-standalone-start.sh; do
        if ! grep -Fx "./$required" "$UPDATE_DIR/files" >/dev/null &&
           ! grep -Fx "$required" "$UPDATE_DIR/files" >/dev/null; then
            printf "${RED}Ошибка: в релизе отсутствует %s; текущая установка сохранена.${NC}\n" "$required"
            exit 1
        fi
    done

    # Stop current services safely (guard against legacy stop.sh running killall -9 soloist on ourselves)
    printf "Остановка старых служб...\n"
    if [ -f "$INSTALL_DIR/stop.sh" ]; then
        if grep -q '^killall -9 soloist ' "$INSTALL_DIR/stop.sh" 2>/dev/null; then
            sed 's/^killall -9 soloist /true /' "$INSTALL_DIR/stop.sh" | sh >/dev/null 2>&1 || true
        else
            "$INSTALL_DIR/stop.sh" >/dev/null 2>&1 || true
        fi
    fi

    # Backup existing configuration
    SAVED_CONF=""
    if [ -f "$INSTALL_DIR/spotify_api.conf" ]; then
        SAVED_CONF=$(cat "$INSTALL_DIR/spotify_api.conf")
    fi

    # Preserve local settings and the running CLI. The verified archive is
    # decompressed through a pipe because BusyBox tar may lack gzip support.
    if ! gzip -dc "$UPDATE_DIR/release.tar.gz" | tar -xf - -C "$INSTALL_DIR" \
        --exclude='./bin/soloist-cli' --exclude='bin/soloist-cli' \
        --exclude='./start.sh' --exclude='start.sh' \
        --exclude='./spotify_api.conf' --exclude='spotify_api.conf' \
        --exclude='./data' --exclude='data' \
        --exclude='./version' --exclude='version' \
        --exclude='./soloist-station-lite.tar.gz' --exclude='soloist-station-lite.tar.gz'; then
        printf "${RED}Ошибка установки файлов; проверьте свободное место и повторите обновление.${NC}\n"
        exit 1
    fi

    # Fix permissions and refresh top-level helper copies from scripts/
    [ ! -f "$INSTALL_DIR/scripts/stop.sh" ] || cp -f "$INSTALL_DIR/scripts/stop.sh" "$INSTALL_DIR/stop.sh" 2>/dev/null || true
    [ ! -f "$INSTALL_DIR/scripts/status.sh" ] || cp -f "$INSTALL_DIR/scripts/status.sh" "$INSTALL_DIR/status.sh" 2>/dev/null || true
    chmod 755 "$INSTALL_DIR/bin/"* "$INSTALL_DIR/scripts/"*.sh "$INSTALL_DIR/scripts/soloist-cli" "$INSTALL_DIR/stop.sh" "$INSTALL_DIR/status.sh" 2>/dev/null || true

    # Update CLI itself safely (atomic rename so running script is not truncated)
    if [ -f "$INSTALL_DIR/scripts/soloist-cli" ]; then
        cp -f "$INSTALL_DIR/scripts/soloist-cli" "$INSTALL_DIR/bin/soloist-cli.new"
        chmod 755 "$INSTALL_DIR/bin/soloist-cli.new"
        mv -f "$INSTALL_DIR/bin/soloist-cli.new" "$INSTALL_DIR/bin/soloist-cli"
        ln -sf "$INSTALL_DIR/bin/soloist-cli" /data/opt/bin/soloist 2>/dev/null || true
        ln -sf "$INSTALL_DIR/bin/soloist-cli" /data/opt/bin/soloistctl 2>/dev/null || true
    fi

    # Save version
    printf "%s\n" "$LATEST" > "$INSTALL_DIR/version"

    # Restore conf if needed
    if [ -n "$SAVED_CONF" ] && [ ! -s "$INSTALL_DIR/spotify_api.conf" ]; then
        printf "%s\n" "$SAVED_CONF" > "$INSTALL_DIR/spotify_api.conf"
        chmod 600 "$INSTALL_DIR/spotify_api.conf"
    fi

    # Cleanup any old update debris
    rm -rf /tmp/soloist_update* /data/local/tmp/soloist_update* 2>/dev/null || true

    # Ensure legacy standalone start.sh gets new runtime env & guard before restart
    [ ! -f "$INSTALL_DIR/scripts/migrate-standalone-guard.sh" ] || sh "$INSTALL_DIR/scripts/migrate-standalone-guard.sh" "$INSTALL_DIR" || true
    [ ! -f "$INSTALL_DIR/scripts/migrate-standalone-start.sh" ] || sh "$INSTALL_DIR/scripts/migrate-standalone-start.sh" "$INSTALL_DIR" || true

    # Restart
    printf "Запуск обновлённого Soloist...\n"
    sh "$INSTALL_DIR/start.sh"

    printf "\n${BOLD}${GREEN}Обновление до %s успешно завершено!${NC}\n" "$LATEST"
    printf "Временный мусор и архив автоматически очищены.\n"
}

trim_ws() {
    printf '%s\n' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

detect_station_model() {
    _compat=""
    if [ -f /proc/device-tree/compatible ]; then
        _compat=$(tr '\0' ' ' < /proc/device-tree/compatible 2>/dev/null || true)
    fi
    case "${YAM_PLATFORM:-}$_compat" in
        *yandexmicro*|*station-micro*|*micro*) printf 'Yandex Station Lite\n' ;;
        *yandexplum*|*plum*) printf 'Yandex Station Lite 2\n' ;;
        *yandexmini_2*|*station-mini2*) printf 'Yandex Station Mini 2\n' ;;
        *bergamot*|*station-mini3*) printf 'Yandex Station Mini 3\n' ;;
        *pickle*) printf 'Yandex Station Mini 3 Pro\n' ;;
        *yandexmini*|*station-mini*) printf 'Yandex Station Mini\n' ;;
        *yandexmidi*|*cucumber*|*amlogic,a5*|*amlogic,\ a5*) printf 'Yandex Station Midi\n' ;;
        *yandexstation_2*|*station-midi*|*midi*) printf 'Yandex Station 2\n' ;;
        *orion*) printf 'Yandex Station Max\n' ;;
        *) printf 'Yandex Station\n' ;;
    esac
}

normalize_favorites_uri() {
    _raw=$(trim_ws "$1")
    case "$_raw" in
        spotify:user:*:collection)
            _user=${_raw#spotify:user:}
            _user=${_user%:collection}
            case "$_user" in
                ''|*[!A-Za-z0-9._-]*) return 1;;
            esac
            [ "${#_raw}" -le 127 ] || return 1
            printf '%s\n' "$_raw"
            return
            ;;
        spotify:playlist:*)
            _pid="${_raw#spotify:playlist:}"
            _pid="${_pid%%\?*}"
            ;;
        *open.spotify.com/playlist/*)
            _pid="${_raw#*open.spotify.com/playlist/}"
            _pid="${_pid%%\?*}"
            _pid="${_pid%%/*}"
            ;;
        *) return 1 ;;
    esac
    case "$_pid" in
        ''|*[!A-Za-z0-9]*) return 1 ;;
    esac
    [ "${#_pid}" -eq 22 ] || return 1
    printf 'spotify:playlist:%s\n' "$_pid"
}

update_hosts_sni() {
    _enable="$1"
    if [ -f "$INSTALL_DIR/scripts/spotify-network.sh" ]; then
        mkdir -p "$CONF_DIR" "$DATA_ROOT"
        if [ "$_enable" = 1 ]; then _net_mode=auto; else _net_mode=off; fi
        printf 'SOLOIST_NETWORK_MODE="%s"\n' "$_net_mode" > "$CONF_DIR/spotify-network.conf"
        if [ "$_net_mode" = auto ]; then
            SOLOIST_NET_BASE="$INSTALL_DIR" SOLOIST_NET_STATE="$DATA_ROOT" SOLOIST_NET_CONF="$CONF_DIR/spotify-network.conf" \
                sh "$INSTALL_DIR/scripts/spotify-network.sh" check || true
        else
            if ! SOLOIST_NET_BASE="$INSTALL_DIR" SOLOIST_NET_STATE="$DATA_ROOT" sh "$INSTALL_DIR/scripts/spotify-network.sh" off; then
                printf "Не удалось убрать записи Spotify из hosts; повторите настройку.\n" >&2
                return 1
            fi
        fi
        return
    fi
    _hosts="${SOLOIST_HOSTS_FILE:-/etc/hosts}"
    [ -e "$_hosts" ] || return 0

    _remounted=0
    if [ "$_hosts" = "/etc/hosts" ]; then
        mount -o remount,rw / 2>/dev/null && _remounted=1 || true
        if [ ! -f /etc/ssl/certs/ca-certificates.crt ] && [ -f /system/vendor/quasar/ca-certificates.crt ]; then
            mkdir -p /etc/ssl/certs
            ln -sf /system/vendor/quasar/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt 2>/dev/null || true
        fi
    fi

    if [ "$_enable" = "1" ]; then
        if ! grep -q "5.175.161.40" "$_hosts" 2>/dev/null; then
            cat << 'HOSTS_EOF' >> "$_hosts"

# Spotify SNI Proxy (Bypass 403 geoblock)
5.175.161.40 accounts.spotify.com
5.175.161.40 api.spotify.com
5.175.161.40 open.spotify.com
5.175.161.40 spclient.wg.spotify.com
HOSTS_EOF
        fi
    else
        sed -e '/^# Spotify SNI Proxy/d' -e '/^5\.175\.161\.40[[:space:]]/d' "$_hosts" > "$_hosts.tmp" 2>/dev/null \
            && chmod 644 "$_hosts.tmp" 2>/dev/null \
            && mv "$_hosts.tmp" "$_hosts" || rm -f "$_hosts.tmp"
    fi

    [ "$_remounted" = 0 ] || mount -o remount,ro / 2>/dev/null || true
}

cmd_setup() {
    if [ -x /system/bin/getprop ]; then
        printf "Внимание: обнаружен Android. Для Station Max может понадобиться отдельный аудиомост.\n"
    fi
    printf "Обнаружена колонка: %s\n\n" "$(detect_station_model)"
    printf "${BOLD}${GREEN}=== Мастер настройки Spotify Soloist ===${NC}\n\n"

    CURR_API_KEY=""
    CURR_DEVICE_NAME=""
    if [ "$IS_YAM" = 1 ] && [ -f "$CONF_DIR/config.env" ]; then
        . "$CONF_DIR/config.env" 2>/dev/null || true
        CURR_API_KEY="${API_KEY:-}"
        CURR_DEVICE_NAME="${DEVICE_NAME:-}"
    elif [ -f "$INSTALL_DIR/start.sh" ]; then
        CURR_API_KEY=$(grep -o 'API_KEY="[^"]*"' "$INSTALL_DIR/start.sh" 2>/dev/null | head -n 1 | cut -d'"' -f2 || true)
        CURR_DEVICE_NAME=$(grep -o -- '-n "[^"]*"' "$INSTALL_DIR/start.sh" 2>/dev/null | head -n 1 | cut -d'"' -f2 || true)
    fi
    [ "$CURR_API_KEY" != "dummy" ] || CURR_API_KEY=""

    CURR_CID=""
    CURR_CSECRET=""
    CURR_MARKET=""
    CURR_LED_VIS=""
    CURR_LED_ANIM=""
    if [ -f "$CONF_DIR/spotify_api.conf" ]; then
        . "$CONF_DIR/spotify_api.conf" 2>/dev/null || true
        CURR_CID="${SPOTIFY_CLIENT_ID:-}"
        CURR_CSECRET="${SPOTIFY_CLIENT_SECRET:-}"
        case "${SPOTIFY_MARKET:-}" in [A-Za-z][A-Za-z]) CURR_MARKET=$SPOTIFY_MARKET ;; esac
        case "${LED_VISUALIZER:-}" in ''|*[!A-Za-z0-9_-]*) ;; *) CURR_LED_VIS=$LED_VISUALIZER ;; esac
        _raw_anim="${LED_ANIMATIONS:-${LED_FX:-}}"
        case "$_raw_anim" in ''|*[!A-Za-z0-9_-]*) ;; *) CURR_LED_ANIM=$_raw_anim ;; esac
    fi

    CURR_FAV=""
    if [ -f "$DATA_ROOT/favorites.uri" ]; then
        CURR_FAV=$(trim_ws "$(cat "$DATA_ROOT/favorites.uri" 2>/dev/null || true)")
    fi

    # 1. Soloist API Key
    printf "${BOLD}1. Soloist API Key (Spotify Connect)${NC}\n"
    printf "   Получить можно (нужен Spotify Premium): ${CYAN}https://developer.spotify.com/dashboard/soloist${NC}\n"
    while true; do
        if [ -n "$CURR_API_KEY" ]; then
            _preview=$(printf '%s' "$CURR_API_KEY" | cut -c1-8)
            printf "   Введите API Key [Enter — оставить %s...]: " "$_preview"
        else
            printf "   Введите ваш API Key (spak_...): "
        fi
        _read_ok=1
        IFS= read -r _in_key || _read_ok=0
        _in_key=$(trim_ws "${_in_key:-}")
        if [ -z "$_in_key" ]; then
            if [ -n "$CURR_API_KEY" ]; then
                NEW_API_KEY="$CURR_API_KEY"
                break
            fi
            if [ "$_read_ok" = 0 ]; then
                printf "\n${RED}Ошибка: API Key не задан (EOF).${NC}\n" >&2
                exit 1
            fi
            printf "${RED}   API Key не может быть пустым.${NC}\n"
            continue
        fi
        case "$_in_key" in
            *[!A-Za-z0-9_-]*)
                printf "${RED}   Недопустимые символы в API Key (разрешены латиница, цифры, _ и -).${NC}\n"
                continue
                ;;
        esac
        NEW_API_KEY="$_in_key"
        break
    done
    printf "\n"

    # 2. Device Name
    DEFAULT_DEV="${CURR_DEVICE_NAME:-$(detect_station_model)}"
    printf "${BOLD}2. Имя колонки в приложении Spotify${NC}\n"
    while true; do
        printf "   Имя устройства [%s]: " "$DEFAULT_DEV"
        _read_ok=1
        IFS= read -r _in_dev || _read_ok=0
        _in_dev=$(trim_ws "${_in_dev:-}")
        [ -n "$_in_dev" ] || _in_dev="$DEFAULT_DEV"
        case "$_in_dev" in
            *[\"\$\`\\]*)
                if [ "$_read_ok" = 0 ]; then
                    printf "\n${RED}Ошибка: некорректное имя устройства (EOF).${NC}\n" >&2
                    exit 1
                fi
                printf "${RED}   Имя не должно содержать символы \" \$ \` или \\.${NC}\n"
                continue
                ;;
        esac
        NEW_DEVICE_NAME="$_in_dev"
        break
    done
    printf "\n"

    # 3. Spotify Web API Keys
    printf "${BOLD}3. Ключи Spotify Web API (для голосового поиска Алисы, опционально)${NC}\n"
    printf "   Создайте приложение на: ${CYAN}https://developer.spotify.com/dashboard${NC}\n"
    NEW_CID="$CURR_CID"
    NEW_CSECRET="$CURR_CSECRET"
    if [ -n "$CURR_CID" ] && [ -n "$CURR_CSECRET" ]; then
        _cid_prev=$(printf '%s' "$CURR_CID" | cut -c1-8)
        printf "   Client ID [Enter — оставить %s..., или 'clear' для очистки]: " "$_cid_prev"
    else
        printf "   Client ID [Enter — пропустить]: "
    fi
    IFS= read -r _in_cid || true
    _in_cid=$(trim_ws "${_in_cid:-}")
    if [ "$_in_cid" = "clear" ] || [ "$_in_cid" = "-" ]; then
        NEW_CID=""
        NEW_CSECRET=""
    elif [ -n "$_in_cid" ]; then
        case "$_in_cid" in
            *[!A-Za-z0-9_-]*)
                printf "${RED}   Некорректный Client ID — сохранён предыдущий.${NC}\n"
                ;;
            *)
                printf "   Client Secret: "
                IFS= read -r _in_sec || true
                _in_sec=$(trim_ws "${_in_sec:-}")
                case "$_in_sec" in
                    ''|*[!A-Za-z0-9_-]*)
                        printf "${YELLOW}   Некорректный или пустой Client Secret — Web API ключи не изменены.${NC}\n"
                        ;;
                    *)
                        NEW_CID="$_in_cid"
                        NEW_CSECRET="$_in_sec"
                        ;;
                esac
                ;;
        esac
    fi
    if [ -z "$NEW_CID" ] || [ -z "$NEW_CSECRET" ]; then
        printf "${YELLOW}   [!] Без ключей Web API голосовой поиск («Алиса, включи песню...») не работает,${NC}\n"
        printf "${YELLOW}       но воспроизведение через приложение Spotify (Connect) будет работать.${NC}\n"
    fi
    printf "\n"

    # 4. Favorites playlist URI
    printf "${BOLD}4. Плейлист для «Любимые треки» / «Мне нравится» (опционально)${NC}\n"
    printf "   У Spotify нет прямой ссылки на раздел «Любимые треки» для запуска с нуля.\n"
    printf "   Создайте отдельный обычный плейлист в Spotify и вставьте ссылку на него (open.spotify.com/playlist/...) или spotify:playlist:...\n"
    NEW_FAV="$CURR_FAV"
    while true; do
        if [ -n "$CURR_FAV" ]; then
            printf "   URI/ссылка [Enter — оставить %s, или 'clear']: " "$CURR_FAV"
        else
            printf "   URI/ссылка [Enter — пропустить]: "
        fi
        _read_ok=1
        IFS= read -r _in_fav || _read_ok=0
        _in_fav=$(trim_ws "${_in_fav:-}")
        if [ -z "$_in_fav" ]; then
            break
        elif [ "$_in_fav" = "clear" ] || [ "$_in_fav" = "-" ]; then
            NEW_FAV=""
            break
        elif _norm=$(normalize_favorites_uri "$_in_fav"); then
            NEW_FAV="$_norm"
            break
        else
            if [ "$_read_ok" = 0 ]; then
                printf "\n${RED}Ошибка: некорректный URI плейлиста (EOF).${NC}\n" >&2
                exit 1
            fi
            printf "${RED}   Не удалось распознать URI избранного или ссылку на плейлист.${NC}\n"
        fi
    done
    printf "\n"

    # 5. SNI Proxy
    _hosts_file="${SOLOIST_HOSTS_FILE:-/etc/hosts}"
    _sni_on=0
    grep -q "5.175.161.40" "$_hosts_file" 2>/dev/null && _sni_on=1 || true
    if [ -f "$CONF_DIR/spotify-network.conf" ] && grep -q '^SOLOIST_NETWORK_MODE="*auto"*$' "$CONF_DIR/spotify-network.conf"; then
        _sni_on=1
    fi
    printf "${BOLD}5. Встроенный SNI-прокси для обхода блокировки 403 (/etc/hosts)${NC}\n"
    if [ -f "$INSTALL_DIR/scripts/spotify-network.sh" ]; then
        printf "   Проверка Spotify API и прокси (может занять до минуты)...\n"
        _net_recommend=$(SOLOIST_NET_BASE="$INSTALL_DIR" sh "$INSTALL_DIR/scripts/spotify-network.sh" recommend)
        if [ "$_net_recommend" = current ]; then
            printf "   Spotify API доступен через текущие настройки сети.\n"
            if [ "$_sni_on" = 0 ]; then
                printf "   Рекомендуется сохранить текущую сеть.\n"
                _net_default=0
            else
                _net_default=1
            fi
        elif [ "$_net_recommend" = proxy ]; then
            printf "   Текущая сеть недоступна, найден рабочий прокси; рекомендуется автовыбор.\n"
            _net_default=1
        else
            printf "   Spotify API и проверенные прокси недоступны; текущие настройки сохранятся.\n"
            _net_default="$_sni_on"
        fi
    else
        _net_default=1
    fi
    if [ "$_sni_on" = 1 ]; then
        printf "   Сейчас прокси включён. Оставить включённым? [Y/n]: "
    else
        if [ "$_net_default" = 0 ]; then printf "   Включить автоматический Spotify-прокси? [y/N]: "; else printf "   Включить автоматический Spotify-прокси? [Y/n]: "; fi
    fi
    IFS= read -r _in_sni || true
    case "$(trim_ws "${_in_sni:-}")" in
        [nN]|[nN][oO]|н|Н|нет|Нет) NEW_SNI=0 ;;
        [yY]|[yY][eE][sS]|д|Д|да|Да) NEW_SNI=1 ;;
        *) NEW_SNI="$_net_default" ;;
    esac
    printf "\n"

    # Apply settings
    mkdir -p "$CONF_DIR" "$DATA_ROOT/requests"
    chmod 700 "$DATA_ROOT/requests" 2>/dev/null || true

    if [ "$IS_YAM" = 0 ] && [ -f "$INSTALL_DIR/start.sh" ]; then
        NEW_API_KEY="$NEW_API_KEY" NEW_DEVICE_NAME="$NEW_DEVICE_NAME" awk '
            /^API_KEY="/ { print "API_KEY=\"" ENVIRON["NEW_API_KEY"] "\""; next }
            /^[[:space:]]*-n ".*" \\$/ { sub(/-n "[^"]*"/, "-n \"" ENVIRON["NEW_DEVICE_NAME"] "\""); print; next }
            { print }
        ' "$INSTALL_DIR/start.sh" > "$INSTALL_DIR/start.sh.tmp" && \
            chmod 755 "$INSTALL_DIR/start.sh.tmp" && \
            mv -f "$INSTALL_DIR/start.sh.tmp" "$INSTALL_DIR/start.sh"
    else
        (
            umask 077
            cat > "$CONF_DIR/config.env" << EOF
API_KEY="$NEW_API_KEY"
DEVICE_NAME="$NEW_DEVICE_NAME"
EOF
            chmod 600 "$CONF_DIR/config.env" 2>/dev/null || true
        )
    fi

    if [ -n "$NEW_CID" ] && [ -n "$NEW_CSECRET" ]; then
        (
            umask 077
            cat > "$CONF_DIR/spotify_api.conf" << EOF
SPOTIFY_CLIENT_ID='$NEW_CID'
SPOTIFY_CLIENT_SECRET='$NEW_CSECRET'
EOF
            if [ -n "$CURR_MARKET" ]; then
                printf "SPOTIFY_MARKET='%s'\n" "$CURR_MARKET" >> "$CONF_DIR/spotify_api.conf"
            fi
            if [ -n "$CURR_LED_VIS" ]; then
                printf "LED_VISUALIZER='%s'\n" "$CURR_LED_VIS" >> "$CONF_DIR/spotify_api.conf"
            fi
            if [ -n "$CURR_LED_ANIM" ]; then
                printf "LED_ANIMATIONS='%s'\n" "$CURR_LED_ANIM" >> "$CONF_DIR/spotify_api.conf"
            fi
            chmod 600 "$CONF_DIR/spotify_api.conf" 2>/dev/null || true
        )
    elif [ "$_in_cid" = "clear" ] || [ "$_in_cid" = "-" ]; then
        rm -f "$CONF_DIR/spotify_api.conf"
    fi

    if [ -n "$NEW_FAV" ]; then
        printf '%s\n' "$NEW_FAV" > "$DATA_ROOT/favorites.uri"
        chmod 600 "$DATA_ROOT/favorites.uri" 2>/dev/null || true
    else
        rm -f "$DATA_ROOT/favorites.uri"
    fi

    update_hosts_sni "$NEW_SNI"

    printf "${GREEN}Настройки сохранены!${NC}\n"
    printf "  Конфиг:  %s\n" "$CONF_DIR"
    printf "  Данные:  %s\n" "$DATA_ROOT"

    if [ "${SOLOIST_SETUP_NO_RESTART:-0}" != 1 ]; then
        printf "\n"
        cmd_restart
    fi
    printf "\nПроверить работу: ${CYAN}soloist status${NC}\n"
}

cmd_network() {
    case "${1:-status}" in
        status|st)
            _net_mode=$(read_network_mode)
            _net_proxy=$(read_network_proxy)
            printf "Режим Spotify SNI: %s\n" "${_net_mode:-default}"
            printf "Прокси в hosts:    %s\n" "${_net_proxy:-none}"
            ;;
        auto|on|1)
            update_hosts_sni 1
            if [ "${SOLOIST_SETUP_NO_RESTART:-0}" != 1 ]; then
                cmd_restart
            fi
            ;;
        off|0)
            update_hosts_sni 0
            if [ "${SOLOIST_SETUP_NO_RESTART:-0}" != 1 ]; then
                cmd_restart
            fi
            ;;
        check|probe)
            _net_mode=$(read_network_mode)
            if [ "$_net_mode" != auto ]; then
                printf "Режим SNI Сейчас '%s'. Включите автоподбор: soloist network auto\n" "${_net_mode:-default}"
                return 0
            fi
            if [ -f "$INSTALL_DIR/scripts/spotify-network.sh" ]; then
                SOLOIST_NET_BASE="$INSTALL_DIR" SOLOIST_NET_STATE="$DATA_ROOT" SOLOIST_NET_CONF="$CONF_DIR/spotify-network.conf" \
                    sh "$INSTALL_DIR/scripts/spotify-network.sh" check
            else
                printf "Скрипт spotify-network.sh не найден.\n" >&2
                return 1
            fi
            ;;
        *)
            printf "Использование: soloist network [status|auto|off|check]\n" >&2
            return 2
            ;;
    esac
}

# Main entrypoint
case "${1:-}" in
    setup|configure|wizard)
        cmd_setup
        ;;
    status|st)
        cmd_status
        ;;
    network|net)
        shift
        cmd_network "$@"
        ;;
    doctor)
        shift
        cmd_doctor "$@"
        ;;
    led)
        shift
        cmd_led "$@"
        ;;
    restart|res)
        cmd_restart
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    logs|log)
        shift
        cmd_logs "$@"
        ;;
    clean|gc)
        cmd_clean
        ;;
    update|up)
        shift
        cmd_update "$@"
        ;;
    version|-v|--version)
        cmd_version
        ;;
    help|-h|--help|"")
        cmd_help
        ;;
    *)
        printf "${RED}Неизвестная команда: %s${NC}\n\n" "$1"
        cmd_help
        exit 1
        ;;
esac
